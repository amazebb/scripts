#!/usr/bin/env bash

VERSION="1.0.0"

usage() {
    cat <<EOF
backup_camera - Backup photos from Sony camera

Usage: backup_camera [options] [SD] [BACKUP] SRC DEST
 
Options:
  -h, --help    Show this help message
  --version     Show version information
  -d, --date    exiftool will process photos newer than the given date when creating symlinks, default all
  -s, --symlink Create symlinks
 
Arguments:
  SD      Camera SD card folder to backup
  BACKUP  Where to backup SD card to
  SRC     Source folder for symlinks to create YYYY/YYYYMMDD/
  TARGET  Target folder for symlinks

Example: backup_camera "/Volumes/SD1/DCIM" "/Volumes/PHOTOS-01-T7/SD Card"
EOF
    exit 0
}

version() {
    echo "$VERSION"
    exit 0
}

SRC="/Volumes/PHOTOS-01-T7/SD Card/DCIM/100MSDCF"
TARGET="/Volumes/PHOTOS-01-T7"
DATE="1900-01-01"
NUM_PROC="1" #$(sysctl -n hw.ncpu)"

# Parse arguments
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --version) version ;;
    --)
        shift
        break
        ;;
    -d | --date)
        if (($# < 2)); then
            echo "Error: -d|--date requires an argument" >&2
            usage
        fi
        DATE="$2"
        shift
        ;;
    -*)
        echo "Unknown option: $1" >&2
        usage
        ;;
    *) break ;; # Non-option args (positionals)
    esac
    shift
done

SD="$1"
shift
BACKUP="$1"
shift
SRC="$1"
shift
TARGET="$1"
shift

# Copy photos from camera internal SD card to external SSD
# rsync -avhP "$SD" "$BACKUP" 2>"/Volumes/PHOTOS-01-T7/rsync_$(date +%Y%m%dT%H%M%S).log"

# shellcheck disable=SC2016
find "$SRC" -type f -newermt "$DATE" -print0 |
    xargs -0 -P"$NUM_PROC" exiftool -fast2 \
        -printFormat '$Directory/$FileName|$DateTimeOriginal' \
        -dateFormat '%Y/%Y-%m/%d' |
    while IFS='|' read -r src date; do
        [ -z "$date" ] && continue
        target_dir="$TARGET/$date"
        mkdir -p "$target_dir"
        src_file=$(realpath --relative-to="$target_dir" "$src")
        ln -sf "$src_file" "$target_dir/" 2>/dev/null
    done
