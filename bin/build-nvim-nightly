#!/usr/bin/env bash
# Pull latest neovim commit and build

# shellcheck disable=SC2016
# shellcheck source=common.sh
source "$(dirname "$0")/common.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B build-nvim-nightly) - Pull latest neovim commit and build

$(B SYNOPSIS)
    $(B "build-nvim-nightly [-h]") [$(B -r) $(U repo)] [$(B -d) $(U dir)]

$(B DESCRIPTION)
    Pulls the latest neovim commit from the local repo and builds
    a nightly release, installing it to the specified directory.

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -r) $(U repo)   Local neovim repo $(I "(default: \$HOME/Code/GitHub/neovim)")

    $(B -d) $(U dir)    Install folder for nvim-nightly build $(I "(default: \$HOME/.nvim-nightly)")

$(B EXAMPLES)
    Build using defaults

        build-nvim-nightly

    Build from a custom repo location

        build-nvim-nightly -r ~/src/neovim -d ~/.local/nvim-nightly

EOF
}

typeset -A var
var[-r]="$HOME/Code/GitHub/neovim"
var[-d]="$HOME/.nvim-nightly"

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -r | -d)
        var["$1"]=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

REPO="${var[-r]}"
NVIM_NIGHTLY="${var[-d]}"

if [[ ! -d "$REPO" || ! -d "$REPO/.git" ]]; then
    info "No git repo found at: $REPO"
    Q "Clone neovim into $REPO?"
    mkdir -p "$(dirname "$REPO")"
    git clone https://github.com/neovim/neovim "$REPO" || warn "Clone failed"
fi

echo "$(B Repo):    $REPO"
echo "$(B Install): $NVIM_NIGHTLY"
echo "$(B Link):    $HOME/.local/bin"
echo

Q "Pull latest and build neovim nightly?"
cd "$REPO" || exit
pull_output=$(git pull)
echo "$pull_output"
if [[ "$pull_output" == "Already up to date." ]]; then
    Q "No changes from git pull. Proceed with build anyway?"
fi

if ! command -v cmake &>/dev/null; then
    info "cmake is not installed"
    Q "Install cmake via brew?"
    brew install cmake || warn "cmake install failed"
fi

info "$(B Making latest nightly build...)"
rm -rf build
make CMAKE_BUILD_TYPE=Release CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=$NVIM_NIGHTLY"

info "$(B "Removing $NVIM_NIGHTLY/lib and $NVIM_NIGHTLY/share...")"
rm -rf "${NVIM_NIGHTLY:?}/lib"
rm -rf "${NVIM_NIGHTLY:?}/share"

info "$(B Installing latest nightly build...)"
make install

info "$(B Linking "$NVIM_NIGHTLY/bin/nvim -> $HOME/.local/bin")"
ln -sf "$NVIM_NIGHTLY/bin/nvim" "$HOME/.local/bin"
