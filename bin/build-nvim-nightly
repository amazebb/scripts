#!/usr/bin/env bash
# Pull latest neovim commit and build

# shellcheck disable=SC2016
U() {
    tput smul
    printf '%s' "$*"
    tput rmul
}

B() {
    tput bold
    printf '%s' "$*"
    tput sgr0
}

I() {
    tput sitm
    printf '%s' "$*"
    tput ritm
}

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

info() { printf "\033[31m%s\033[0m\n" "$1" >&2; }

warn() { info "$1" && exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
    # NOTE Because 'warn' is called in a sub-shell, the exit 1 does not
    # exit immediately. The parse arguments while loop will cycle
    # through all entered args.
}

usage() {
    cat <<EOF
$(B NAME)
    $(B build-nvim-nightly) - Pull latest neovim commit and build

$(B SYNOPSIS)
    $(B "build-nvim-nightly [-h]") [$(B -r) $(U repo)] [$(B -d) $(U dir)]

$(B DESCRIPTION)
    Pulls the latest neovim commit from the local repo and builds
    a nightly release, installing it to the specified directory.

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -r) $(U repo)   Local neovim repo $(I "(default: \$HOME/Code/GitHub/neovim)")

    $(B -d) $(U dir)    Install folder for nvim-nightly build $(I "(default: \$HOME/.nvim-nightly)")

$(B EXAMPLES)
    Build using defaults

        build-nvim-nightly

    Build from a custom repo location

        build-nvim-nightly -r ~/src/neovim -d ~/.local/nvim-nightly

EOF
}

typeset -A var
var[-r]="$HOME/Code/GitHub/neovim"
var[-d]="$HOME/.nvim-nightly"

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -r | -d)
        var["$1"]=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

REPO="${var[-r]}"
NVIM_NIGHTLY="${var[-d]}"

[[ ! -d "$REPO" ]] && warn "Error: repo directory not found: $REPO"

echo "$(B Repo):    $REPO"
echo "$(B Install): $NVIM_NIGHTLY"
echo "$(B Link):    $HOME/.local/bin"
echo

Q "Pull latest and build neovim nightly?"

cd "$REPO" || exit
git pull
rm -rf build
make CMAKE_BUILD_TYPE=Release CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=$NVIM_NIGHTLY"
make install
ln -sf "$NVIM_NIGHTLY/bin/nvim" "$HOME/.local/bin"
