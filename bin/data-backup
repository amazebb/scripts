#!/usr/bin/env bash
# Backup folders to SPARSE image in iCloud

# shellcheck disable=SC2016
U() {
    tput smul
    printf '%s' "$*"
    tput rmul
}

B() {
    tput bold
    printf '%s' "$*"
    tput sgr0
}

I() {
    tput sitm
    printf '%s' "$*"
    tput ritm
}

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

msg() { printf "\033[%sm%s\033[0m\n" "$2" "$1" >&2; }

info() { msg "$1" 34; }

warn() { msg "$1" 31 && exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
    # NOTE Because 'warn' is called in a sub-shell, the exit 1 does not
    # exit immediately. The parse arguments while loop will cycle
    # through all entered args.
}

noargs() { ((!$1)) && info "Error: no arguments provided" && usage && exit 1; }

usage() {
    cat <<EOF
$(B NAME)
    $(B data-backup) - Backup folders to encrypted sparse bundle in iCloud

$(B SYNOPSIS)
    $(B "data-backup [-h] [-s bundle] [-m mountpoint]") $(U folder) [$(U folder) ...]

$(B DESCRIPTION)
    Compress folders with 7z and rsync them into an encrypted APFS sparse
    bundle stored in iCloud. Stops Gitea before backup and restarts it after.

$(B OPTIONS)
    $(B -h)            Show this help message

    $(B -s) $(U bundle)     Sparse bundle path $(I '(default: ~/Library/Mobile Documents/.../SPARSE.sparsebundle)')

    $(B -m) $(U mountpoint) Mount point $(I '(default: /Volumes/SPARSE)')

$(B EXAMPLES)
    Backup two folders to the default sparse bundle

        data-backup ~/Documents ~/Projects

    Create the sparse bundle (one-time setup)

        hdiutil create -size 10g -type SPARSEBUNDLE -fs APFS \\
            -encryption -stdinpass -volname SPARSE \\
            ~/Library/Mobile\ Documents/com~apple~CloudDocs/SPARSE.sparsebundle

EOF
}

noargs $#

SPARSE_BUNDLE="$HOME/Library/Mobile Documents/com~apple~CloudDocs/SPARSE.sparsebundle"
MOUNT_POINT="/Volumes/SPARSE"

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -s)
        SPARSE_BUNDLE=$(argval "$@")
        shift
        ;;
    -m)
        MOUNT_POINT=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;;
    esac
    shift
done

FOLDERS=("$@")

((!${#FOLDERS[@]})) && warn "Error: at least one folder is required"

printf "Folders to backup: %s\n" "${FOLDERS[*]}"
printf "Sparse bundle: %s\n" "$SPARSE_BUNDLE"
printf "Mount point: %s\n" "$MOUNT_POINT"

read -r -s -p "Enter sparse bundle password: " PASSWORD
echo

[[ ! -d "$SPARSE_BUNDLE" ]] && warn "Error: Sparse bundle not found at $SPARSE_BUNDLE"
[[ ! -r "$SPARSE_BUNDLE" ]] && warn "Error: No read permission for sparse bundle"

if [[ -d "$MOUNT_POINT" ]]; then
    if hdiutil info | grep -q "$SPARSE_BUNDLE" && hdiutil info | grep -q "$MOUNT_POINT"; then
        echo "$MOUNT_POINT is already mounted"
    else
        warn "Error: $MOUNT_POINT exists but isn't our sparse bundle"
    fi
else
    mount_err=$(mktemp)
    if ! echo -n "$PASSWORD" | hdiutil attach "$SPARSE_BUNDLE" -mountpoint "$MOUNT_POINT" -stdinpass -verbose 2>"$mount_err"; then
        cat "$mount_err" >&2
        rm -f "$mount_err"
        warn "Error: Failed to mount sparse bundle"
    fi
    rm -f "$mount_err"
fi

if ! gitea-cli stop; then
    hdiutil detach "$MOUNT_POINT"
    warn "Error: Failed to stop Gitea"
fi

for FOLDER in "${FOLDERS[@]}"; do
    FULL_PATH=$(realpath "$FOLDER")
    BASE_NAME="${FULL_PATH/#"$HOME"\//HOME}"
    BASE_NAME="${BASE_NAME//\//_}"
    TEMP_FILE="/tmp/${BASE_NAME}-$(date +%Y%m%d_%H%M%S).7z"
    DEST_FOLDER="$MOUNT_POINT/$BASE_NAME"

    if ! 7z a -t7z -m0=lzma2 -mx=9 -mmt=on "$TEMP_FILE" "$FOLDER"; then
        echo "Error: Failed to compress $FOLDER, skipping"
        continue
    fi

    [[ ! -f "$TEMP_FILE" ]] && echo "Error: Temp file not created, skipping" && continue

    echo "$FULL_PATH" >"$TEMP_FILE.txt"

    [[ ! -d "$MOUNT_POINT" ]] && echo "Error: Mount point disappeared, skipping" && continue

    if ! rsync --archive --xattrs --acls --hard-links --progress "$TEMP_FILE" "$TEMP_FILE.txt" "$DEST_FOLDER"; then
        echo "Error: rsync failed for $FOLDER, skipping"
        rm -f "$TEMP_FILE" "$TEMP_FILE.txt"
        continue
    fi

    rm -f "$TEMP_FILE" "$TEMP_FILE.txt"
done

if ! hdiutil detach "$MOUNT_POINT"; then
    warn "Warning: Failed to unmount sparse bundle"
fi

if ! gitea-cli start; then
    warn "Error: Backup successful but failed to start Gitea"
fi
