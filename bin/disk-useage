#!/usr/bin/env bash
# Analyze disk usage by folder size

# shellcheck disable=SC2016

U() { printf '\e[4m%s\e[0m' "$*"; }

B() { printf '\e[1m%s\e[0m' "$*"; }

I() { printf '\e[3m%s\e[0m' "$*"; }

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

color() {
    local name=$1; shift
    local code
    case $name in
        RED)     code=31 ;;
        GREEN)   code=32 ;;
        YELLOW)  code=33 ;;
        BLUE)    code=34 ;;
        MAGENTA) code=35 ;;
        CYAN)    code=36 ;;
        *)       code=0  ;;
    esac
    printf '\e[%sm%s\e[0m' "$code" "$*"
}

msg() { printf '%s\n' "$(color "$2" "$1")" >&2; }

info() { msg "$1" BLUE; }

warn() { msg "$1" RED && exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
    # NOTE Because 'warn' is called in a sub-shell, the exit 1 does not
    # exit immediately. The parse arguments while loop will cycle
    # through all entered args.
}

usage() {
    cat <<EOF
$(B NAME)
    $(B disk-useage) - Analyze disk usage by folder size

$(B SYNOPSIS)
    $(B "disk-useage [-h] [-d depth] [-e pattern ...] [-v]") [$(U path) ...]

$(B DESCRIPTION)
    Summarizes disk usage for directories with configurable depth,
    exclusion patterns, and color-coded size output.

$(B OPTIONS)
    $(B -h)              Show this help message

    $(B -d) $(U depth)        Depth to traverse $(I '(default: 1)')

    $(B -e) $(U pattern) ...  Space-separated list of patterns to exclude
                    $(I '(default: .Trash*)')

    $(B -v)              Show permission denied errors

$(B EXAMPLES)
    Analyze Desktop and Downloads at depth 1

        disk-useage -d 1 Desktop Downloads

    Current dir, depth 2, exclude Lib and Trash, verbose

        disk-useage -d 2 -e ./Lib* ./Trash* -v

EOF
}

# Defaults
DIRS=()
EX="--exclude=.Trash*"
DEPTH="1"
V=0

while (($#)); do
    case "$1" in
    -h | -help | --help)
        usage
        exit 0
        ;;
    -d)
        argval "$@"
        DEPTH="$2"
        shift
        ;;
    -e)
        shift
        EX=""
        while (($#)) && [ "${1#-}" = "$1" ]; do
            EX+=" --exclude=$1"
            shift
        done
        continue
        ;;
    -v)
        V=1
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *)
        DIRS+=("$1")
        ;;
    esac
    shift
done

# Remaining positional args after --
while (($#)); do
    DIRS+=("$1")
    shift
done

# Default to current directory
[ ${#DIRS[@]} -gt 0 ] || DIRS=(".")

# Define colors
white="\033[36m"
red="\033[31m"
green="\033[32m"
orange="\033[38;5;208m"
reset="\033[0m"

temp_err=$(mktemp)
trap 'rm -f "$temp_err"' EXIT

for DIR in "${DIRS[@]}"; do
    du ${DEPTH:+"-d $DEPTH"} ${EX:+"$EX"} "$DIR" 2>>"$temp_err"
done |
    sort -k1 -n |
    awk -F'\t' -v w="$white" -v r="$red" -v g="$green" -v o="$orange" -v rs="$reset" \
        ' $2 != "." {if ($1 < 1024) {t1+=$1; printf "%s%6.0f KiB%s %s\n", w, $1, rs, $2}
    else if ($1 < 100*1024) {t2+=$1; printf "%s%6.2f MiB%s %s\n", o, $1/1024, rs, $2}
    else if ($1 < 1024*1024) {t3+=$1; printf "%s%6.2f MiB%s %s\n", g, $1/1024, rs, $2}
    else {t4+=$1; printf "%s%6.2f GiB%s %s\n", r, $1/1024/1024, rs, $2}}
        END {print ""
            print "Summary"
            if (t1) printf "< 1 MiB:    %s%6.0f (MiB)%s\n", w, t1/1024, rs
            if (t2) printf "< 100 MiB:  %s%6.2f (MiB)%s\n", o, t2/1024, rs
            if (t3) printf "< 1 GiB:    %s%6.2f (GiB)%s\n", g, t3/1024/1024, rs
            if (t4) printf ">=1 GiB:    %s%6.2f (GiB)%s\n", r, t4/1024/1024, rs}'

# Error handling
error_count=$(wc -l <"$temp_err")
if ((error_count > 0)); then
    ((V)) && cat "$temp_err" >&2 ||
        echo "Note: $error_count folders could not be read due to permissions" >&2
fi
