#!/usr/bin/env bash
# Organise files into date-based directories using EXIF metadata

# shellcheck disable=SC2016
# shellcheck source=common.sh
source "$(dirname "$0")/common.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B exifmv) - Organise files into date-based directories using EXIF metadata

$(B SYNOPSIS)
    $(B "exifmv [-h] [-n] [-d fmt]") $(U source_dir) [$(U dest)]

$(B DESCRIPTION)
    Scans $(U source_dir) recursively with exiftool, extracts DateTimeOriginal
    from each file, and moves (or previews) files into a $(I YYYY/YYYYMMDD)
    directory tree under $(U dest) $(I '(default: ./by-date)').

    Files without date metadata are skipped. Name collisions are resolved
    by appending a numeric suffix.

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -n)        Dry run — show what would be moved without moving

    $(B -d) $(U fmt)    Date format for directory structure $(I '(default: %Y/%Y%m%d)')

$(B EXAMPLES)
    Preview what would happen

        exifmv -n /Volumes/SD/DCIM

    Move files into a custom destination

        exifmv /Volumes/SD/DCIM /Photos/Sorted

    Use a flat year-month directory structure

        exifmv -d '%Y-%m' /Volumes/SD/DCIM

EOF
}

noargs $#

DRY_RUN=false
DATE_FMT='%Y/%Y%m%d'
while (($#)); do
    case "$1" in
    -h) usage && exit 0 ;;
    -n) DRY_RUN=true ;;
    -d) DATE_FMT=$(argval "$@") && shift ;;
    --)
        shift
        break
        ;;
    -*) warn "Unknown option: $1" ;;
    *) break ;;
    esac
    shift
done

SRC="${1:-}"
[[ -z "$SRC" ]] && warn "Error: source directory is required"
[[ ! -d "$SRC" ]] && warn "Error: '$SRC' is not a directory"
DEST="${2:-./by-date}"

command -v exiftool &>/dev/null || warn "exiftool not found. Install with: $(I brew install exiftool)"

CACHE="./exif_cache.txt"

total_files=$(find "$SRC" -type f | wc -l)

info "Scanning with exiftool ..."
exiftool -fast2 -recurse \
    -printFormat '$Directory/$FileName|$DateTimeOriginal' \
    -dateFormat "$DATE_FMT" \
    "$SRC" 2>/dev/null >"$CACHE" || true

with_date=$(awk -F'|' 'NF==2 && $2 ~ /\// {c++} END{print c+0}' "$CACHE")
info "Scan complete. ${total_files} files found, ${with_date} with date metadata."

$DRY_RUN || Q "Move ${with_date} files from ${SRC} into ${DEST}?"

moved=0
collisions=0

while IFS='|' read -r file date_path; do
    # Skip lines without a valid date
    if [[ -z "$date_path" || "$date_path" != */* ]]; then
        continue
    fi

    target_dir="${DEST}/${date_path}"
    basename=$(basename "$file")
    target="${target_dir}/${basename}"

    # Handle name collisions
    if [[ -e "$target" ]]; then
        ((collisions++))
        ext="${basename##*.}"
        name="${basename%.*}"
        i=1
        while [[ -e "${target_dir}/${name}_${i}.${ext}" ]]; do
            ((i++))
        done
        target="${target_dir}/${name}_${i}.${ext}"
    fi

    if $DRY_RUN; then
        echo "[dry-run] $file -> $target"
    else
        mkdir -p "$target_dir"
        mv -- "$file" "$target"
    fi
    ((moved++))
done <"$CACHE"

skipped=$((total_files - moved))
echo "Done. Moved: ${moved}, Skipped (no date): ${skipped}, Name collisions: ${collisions}"
$DRY_RUN && echo "(dry run — no files were moved)"
