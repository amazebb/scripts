#!/usr/bin/env zsh
# Search text interactively with ripgrep and fzf

# shellcheck disable=SC2016

U() { printf '\e[4m%s\e[0m' "$*"; }

B() { printf '\e[1m%s\e[0m' "$*"; }

I() { printf '\e[3m%s\e[0m' "$*"; }

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

color() {
    local name=$1; shift
    local code
    case $name in
        RED)     code=31 ;;
        GREEN)   code=32 ;;
        YELLOW)  code=33 ;;
        BLUE)    code=34 ;;
        MAGENTA) code=35 ;;
        CYAN)    code=36 ;;
        *)       code=0  ;;
    esac
    printf '\e[%sm%s\e[0m' "$code" "$*"
}

msg() { printf '%s\n' "$(color "$2" "$1")" >&2; }

info() { msg "$1" BLUE; }

warn() { msg "$1" RED && exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
    # NOTE Because 'warn' is called in a sub-shell, the exit 1 does not
    # exit immediately. The parse arguments while loop will cycle
    # through all entered args.
}

noargs() { ((!$1)) && info "Error: no arguments provided" && usage && exit 1; }

usage() {
    cat <<EOF
$(B NAME)
    $(B fz) - Search text interactively with ripgrep and fzf

$(B SYNOPSIS)
    $(B "fz [-h] [-r option]") $(U pattern)

$(B DESCRIPTION)
    Interactive text search across configured directories using ripgrep
    for searching and fzf for filtering. Supports switching between
    ripgrep and fzf filtering modes, opening results in nvim, and
    building quickfix lists from multiple selections.

$(B OPTIONS)
    $(B -h)          Show this help message

    $(B -r) $(U option)   Additional ripgrep option $(I '(e.g., "-g *.pdf")')

$(B KEYBINDINGS)
    $(B CTRL-T)      Switch between ripgrep and fzf filtering
    $(B ALT-A)       Select all results
    $(B ALT-D)       Deselect all results
    $(B CTRL-P)      Toggle preview pane
    $(B ENTER)       Open in nvim (single) or quickfix (multi); returns to fzf
    $(B CTRL-O)      Same as ENTER

$(B EXAMPLES)
    Search for 'pattern' in all configured directories

        fz pattern

    Search for 'pattern' only in PDF files

        fz -r "-g '*.pdf'" pattern

    Search for a literal '-g'

        fz -- -g

EOF
}

noargs $#

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PRE_RG=(--pre $SCRIPT_DIR/pre-rg --pre-glob '*.{pdf}')

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -r)
        PRE_RG+=("$(argval "$@")") || true
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;;
    esac
    shift
done

[[ -z "$1" ]] && warn "Error: missing pattern"
PATTERN="$1"

FOLDERS=(~ ~/.local/share/scripts ~/.local/share/zsh/site-functions/dotfiles ~/.local/share/zsh/prompt)
OPTS=(--hidden --column --line-number --no-heading --color=always --smart-case)

export _FZ_FOLDERS_STR="${(j:\0:)FOLDERS}"
export _FZ_PRE_RG_STR="${(j:\0:)PRE_RG}"
export _FZ_OPTS_STR="${(j:\0:)OPTS}"
export _FZ_GIT_TRACKED="true"

rg_search() {
    local folders=(${(s:\0:)_FZ_FOLDERS_STR})
    local pre_rg=(${(s:\0:)_FZ_PRE_RG_STR})
    local opts=(${(s:\0:)_FZ_OPTS_STR})
    for d in ${folders[@]}; do
        cd $d
        if [[ $_FZ_GIT_TRACKED == "true" ]] && dotfiles rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            dotfiles ls-files | sed "s|^|$d/|g" | tr '\n' '\0' | xargs -0 rg $pre_rg[@] $opts[@] "$1" || :
        else
            rg $pre_rg[@] $opts[@] "$1" || :
        fi
    done
}

RELOAD_CMD="$(typeset -f rg_search); rg_search {q}"
RELOAD="reload:$RELOAD_CMD"
OPENER='(( FZF_SELECT_COUNT == 0 )) && nvim {1} +{2} || nvim +cw -q {+f}'
BAT_OPTS='--theme=TwoDark --style=full --wrap=character --color=always --highlight-line {2}'
PREVIEW='case {1} in *.pdf) ~/.local/bin/pre-rg {1} | nl -ba -w1 -s" " | bat '"$BAT_OPTS"' ;; *) bat '"$BAT_OPTS"' {1} ;; esac'

fzf --disabled --ansi --multi \
    --bind "start:$RELOAD" --bind "change:$RELOAD" \
    --bind "enter:execute($OPENER)+reload($RELOAD_CMD)" \
    --bind "ctrl-o:execute($OPENER)+reload($RELOAD_CMD)" \
    --bind 'alt-a:select-all,alt-d:deselect-all,ctrl-p:toggle-preview' \
    --bind 'ctrl-t:transform:[[ ! $FZF_PROMPT =~ ripgrep ]] &&
      echo "rebind(change)+change-prompt(1. ripgrep> )+disable-search+transform-query:echo \{q} > /tmp/rg-fzf-f; cat /tmp/rg-fzf-r" ||
      echo "unbind(change)+change-prompt(2. fzf> )+enable-search+transform-query:echo \{q} > /tmp/rg-fzf-r; cat /tmp/rg-fzf-f"' \
    --prompt '1. ripgrep> ' \
    --delimiter : \
    --header 'CTRL-T: Switch between ripgrep/fzf
ALT-A: Select-all, ALT-D: Deselect-all, CTRL-P: Toggle-preview' \
    --style full \
    --layout=reverse-list \
    --preview "$PREVIEW" \
    --preview-window '~4,+{2}+4/3,<80(up)' \
    --query "$PATTERN"
