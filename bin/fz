#!/usr/bin/env bash
# Search text interactively with ripgrep and fzf

# shellcheck disable=SC2016
# shellcheck source=common.sh
source "$(dirname "$0")/common.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B fz) - Search text interactively with ripgrep and fzf

$(B SYNOPSIS)
    $(B "fz [-h] [-l] [-i] [-g [true|false]] [-o option] [-r option]") $(U pattern) [$(U path)]

$(B DESCRIPTION)
    Interactive text search across configured directories using ripgrep
    for searching and fzf for filtering. Supports switching between
    ripgrep and fzf filtering modes, opening results in nvim, and
    building quickfix lists from multiple selections.

    If $(U path) is given, the search is restricted to that directory;
    otherwise the built-in folder list is searched (see $(B -l)).

    Folders marked $(B Git) by $(B -l) are inside a git work tree; for those,
    only files tracked by the repo (git ls-files) are searched. All
    other folders are searched in full with ripgrep.

$(B OPTIONS)
    $(B -h)          Show this help message

    $(B -l)          List the default search folders, one per line, and exit

    $(B -g) [$(U bool)]   Restrict search to git-tracked files. Optional value
                $(B true) or $(B false); a bare $(B -g) means $(B true). Without the
                flag, defaults to $(B true) for the built-in folder list and
                $(B false) when a manual $(U path) is given.

    $(B -i), $(B --ignore-git-dir)
                Skip $(B .git) directories. Shorthand for $(B -o '-g=!.git').

    $(B -o) $(U option)   Pass an arbitrary option through to ripgrep
                $(I "(e.g., -o '-g=!.git' to skip .git folders)"). May be
                repeated.

    $(B -r) $(U option)   Extend the ripgrep $(B --pre) preprocessor setup. Use
                this to add more $(B --pre-glob) patterns so additional file
                types are routed through $(B _pre-rg) before being searched
                $(I '(e.g., -r "--pre-glob=*.docx")'). Not a general passthrough
                for arbitrary ripgrep flags.

$(B KEYBINDINGS)
    $(B CTRL-T)      Switch between ripgrep and fzf filtering
    $(B ALT-A)       Select all results
    $(B ALT-D)       Deselect all results
    $(B CTRL-P)      Toggle preview pane
    $(B ENTER)       Open in nvim (single) or quickfix (multi); returns to fzf
    $(B CTRL-O)      Same as ENTER

$(B EXAMPLES)
    Search for 'pattern' in all configured directories

        fz pattern

    Search for 'pattern' under a specific directory

        fz pattern ~/projects/foo

    Also preprocess .docx files through _pre-rg

        fz -r "--pre-glob=*.docx" pattern

    Skip .git folders while searching

        fz -i pattern
        fz -o "-g=!.git" pattern

    Search for just Project.toml files with an empty pattern ''.
    Skipping .git(-i), .vscode, and .julia folders.

        fz -i -o "-g=Project.toml" -o "-g=\!.julia" -o "-g=\!.vscode" -o "--files" '' ~/

    Search for a literal '-g'

        fz -- -g

    List the default search folders

        fz -l

EOF
}

noargs $#

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PRE_RG=(--pre "$SCRIPT_DIR/_pre-rg" --pre-glob '*.{pdf}')
FOLDERS=(~ ~/.local/share/scripts ~/.local/share/zsh/site-functions/dotfiles ~/.local/share/zsh/prompt)
OPTS=(--hidden --column --line-number --no-heading --color=always --smart-case --stats)
GIT_TRACKED="true"
GIT_EXPLICIT=""

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -l)
        for d in "${FOLDERS[@]}"; do
            git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
                printf '%s\tGit\n' "${d/#$HOME/\~}" ||
                printf '%s\n' "${d/#$HOME/\~}"
        done | column -t -s $'\t'
        exit 0
        ;;
    -g)
        GIT_EXPLICIT="true"
        if [[ $2 == "true" || $2 == "false" ]]; then
            GIT_TRACKED="$2"
            shift
        else
            GIT_TRACKED="true"
        fi
        ;;
    -i | --ignore-git-dir) OPTS+=("-g=!.git") ;;
    -o)
        (($# < 2)) && warn "Error: -o requires a valid argument"
        OPTS+=("$2")
        shift
        ;;
    -r)
        PRE_RG+=("$(argval "$@")") || true
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;;
    esac
    shift
done

# Count args rather than test emptiness, so an explicit '' is a valid pattern
(($# == 0)) && warn "Error: missing pattern"
PATTERN="$1"
# rg --files lists names instead of matches, so fzf is driven differently
FILES_MODE="false"
for o in "${OPTS[@]}"; do [[ $o == "--files" ]] && FILES_MODE="true"; done
if [[ -n "$2" ]]; then
    FOLDERS=("$2")
    [[ -z "$GIT_EXPLICIT" ]] && GIT_TRACKED="false"
fi

export _FZ_FOLDERS_STR=$(printf '%q ' "${FOLDERS[@]}")
export _FZ_PRE_RG_STR=$(printf '%q ' "${PRE_RG[@]}")
export _FZ_OPTS_STR=$(printf '%q ' "${OPTS[@]}")
export _FZ_GIT_TRACKED="$GIT_TRACKED"
export _FZ_FILES="$FILES_MODE"

rg_search() {
    local folders pre_rg opts d f paths=()
    eval "folders=($_FZ_FOLDERS_STR)"
    eval "pre_rg=($_FZ_PRE_RG_STR)"
    eval "opts=($_FZ_OPTS_STR)"
    for d in "${folders[@]}"; do
        cd "$d" || continue
        if [[ $_FZ_GIT_TRACKED == "true" ]] && dotfiles --print-status >/dev/null 2>&1; then
            while IFS= read -r f; do paths+=("$d/$f"); done < <(dotfiles ls-files)
        else
            paths+=("$d")
        fi
    done
    ((${#paths[@]})) || return 0
    # --files takes no pattern; a stray one would be read as another path
    if [[ $_FZ_FILES == "true" ]]; then
        rg "${opts[@]}" "${paths[@]}" || :
    else
        rg "${pre_rg[@]}" "${opts[@]}" "$1" "${paths[@]}" || :
    fi
}

RELOAD_CMD="$(typeset -f rg_search); rg_search {q}"
RELOAD="reload:$RELOAD_CMD"
OPENER='(( FZF_SELECT_COUNT == 0 )) && nvim {1} +{2} || nvim +cw -q {+f}'
BAT_OPTS='--theme=TwoDark --style=full --wrap=character --color=always $HL'
# --files output has no line number, so bat the whole file with nothing highlighted
PREVIEW='HL={2}; HL=${HL:+--highlight-line $HL}; case {1} in *.pdf) ~/.local/bin/_pre-rg {1} | nl -ba -w1 -s" " | bat '"$BAT_OPTS"' ;; *) bat '"$BAT_OPTS"' {1} ;; esac'

fzf --disabled --ansi --multi \
    --bind "start:$RELOAD" --bind "change:$RELOAD" \
    --bind "enter:execute($OPENER)+reload($RELOAD_CMD)" \
    --bind "ctrl-o:execute($OPENER)+reload($RELOAD_CMD)" \
    --bind 'alt-a:select-all,alt-d:deselect-all,ctrl-p:toggle-preview' \
    --bind 'ctrl-t:transform:[[ ! $FZF_PROMPT =~ ripgrep ]] &&
      echo "rebind(change)+change-prompt(1. ripgrep> )+disable-search+transform-query:echo \{q} > /tmp/rg-fzf-f; cat /tmp/rg-fzf-r" ||
      echo "unbind(change)+change-prompt(2. fzf> )+enable-search+transform-query:echo \{q} > /tmp/rg-fzf-r; cat /tmp/rg-fzf-f"' \
    --prompt '1. ripgrep> ' \
    --delimiter : \
    --header 'CTRL-T: Switch between ripgrep/fzf
ALT-A: Select-all, ALT-D: Deselect-all, CTRL-P: Toggle-preview' \
    --style full \
    --layout=reverse-list \
    --preview "$PREVIEW" \
    --preview-window '~4,+{2}+4/3,50%,wrap-word,right,<50(up,85%,border-bottom)' \
    --query "$PATTERN"
