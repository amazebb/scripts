#!/usr/bin/env zsh
# Search text interactively with ripgrep and fzf
VERSION="1.0.0"

# Help function
usage() {
cat <<EOF
    Usage: fz [OPTIONAL] pattern
    Arguments:
      pattern   Search pattern
    Optional:
      -r        ripgrep option (e.g., \"-g '*.{pdf,zsd}'\")
      -h        Help
      -v        Version
    Examples:
      fz \"-g '*.pdf'\" pattern   Search for 'pattern' in PDF files
      fz -- -g                    Search for literal '-g'
EOF
    exit 0
}

# Version function
version() {
    echo "$VERSION"
    exit 0
}

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PRE_RG=(--pre $SCRIPT_DIR/pre-rg --pre-glob '*.{pdf}')

# Parse optional arguments with getopts
while getopts "hvr:" opt; do
    case "$opt" in
    h) usage ;;
    v) version ;;
    r) PRE_RG="$PRE_RG $OPTARG" ;;
    ?) usage ;;
    esac
done
# Shift past the options
shift $((OPTIND - 1))

# Check required positional inputs
(($# < 1)) && {
    echo "Error: Missing pattern" >&2
    usage
}

PATTERN=$1
FOLDERS=(~ ~/.local/share/scripts ~/.local/share/zsh/site-functions/dotfiles ~/.local/share/zsh-prompt)
OPTS=(--hidden --column --line-number --no-heading --color=always --smart-case)

export _FZ_FOLDERS_STR="${(j:\0:)FOLDERS}"  
export _FZ_PRE_RG_STR="${(j:\0:)PRE_RG}"
export _FZ_OPTS_STR="${(j:\0:)OPTS}"
export _FZ_GIT_TRACKED="true"

# In your script before fzf
rg_search() {
    local folders=(${(s:\0:)_FZ_FOLDERS_STR})
    local pre_rg=(${(s:\0:)_FZ_PRE_RG_STR})
    local opts=(${(s:\0:)_FZ_OPTS_STR})
    for d in ${folders[@]}; do
        cd $d
        if [[ $_FZ_GIT_TRACKED == "true" ]] && dotfiles rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            dotfiles ls-files | sed "s|^|$d/|g"  | tr '\n' '\0' | xargs -0 rg $pre_rg[@] $opts[@] "$1" || :
        else
            rg $pre_rg[@] $opts[@] "$1" || :
        fi
    done
}

RELOAD="reload:$(typeset -f rg_search); rg_search {q}"
OPENER='(( FZF_SELECT_COUNT == 0 )) && nvim {1} +{2} || nvim +cw -q {+f}'  # Build quickfix list for the selected items.
BAT_OPTS='--theme=TwoDark --style=full --wrap=character --color=always --highlight-line {2}'
PREVIEW='case {1} in *.pdf) ~/.local/bin/pre-rg {1} | nl -ba -w1 -s" " | bat $BAT_OPTS ;; *) bat $BAT_OPTS {1} ;; esac'

fzf --disabled --ansi --multi \
    --bind "start:$RELOAD" --bind "change:$RELOAD" \
    --bind "enter:become:$OPENER" \
    --bind "ctrl-o:execute:$OPENER" \
    --bind 'alt-a:select-all,alt-d:deselect-all,ctrl-p:toggle-preview' \
    --bind 'ctrl-t:transform:[[ ! $FZF_PROMPT =~ ripgrep ]] &&
      echo "rebind(change)+change-prompt(1. ripgrep> )+disable-search+transform-query:echo \{q} > /tmp/rg-fzf-f; cat /tmp/rg-fzf-r" ||
      echo "unbind(change)+change-prompt(2. fzf> )+enable-search+transform-query:echo \{q} > /tmp/rg-fzf-r; cat /tmp/rg-fzf-f"' \
    --prompt '1. ripgrep> ' \
    --delimiter : \
    --header 'CTRL-T: Switch between ripgrep/fzf 
ALT-A: Select-all, ALT-D: Deselect-all, CTRL-P: Toggle-preview' \
    --style full \
    --layout=reverse-list \
    --preview "$PREVIEW" \
    --preview-window '~4,+{2}+4/3,<80(up)' \
    --query "$PATTERN"

