# vim: ft=zsh
# Interactive man page/tldr searcher with fzf, bat, and key bindings

# shellcheck disable=SC2016

# TODO consider adding GNI info, eg: `info coreutils "$1" invocation 2>/dev/null`
fzf-man() {
    manpage='echo {} |  awk -F"[()]" "{print \$2, \$1}" | MANPAGER=cat xargs man'
    batman="$manpage | bat --style=plain --language=man --color always --theme auto:system"
    _fzf-man-reload | fzf -q "$1" --ansi --style full --tiebreak=begin \
        --header 'alt-m: man(all), alt-(1-9): man(1-9), alt-t: tldr' \
        --prompt='man > ' \
        --preview-window '50%,wrap-word,<50(up,85%,border-bottom)' \
        --preview "$batman" \
        --bind "enter:execute($manpage)" \
        --bind "alt-m:+reload(_fzf-man-reload)+change-preview(${batman})+change-prompt(man > )" \
        --bind "alt-1:+reload(_fzf-man-reload 1)+change-preview(${batman})+change-prompt(man(1) General Commands > )" \
        --bind "alt-2:+reload(_fzf-man-reload 2)+change-preview(${batman})+change-prompt(man(2) System Calls > )" \
        --bind "alt-3:+reload(_fzf-man-reload 3)+change-preview(${batman})+change-prompt(man(3) Library Functions > )" \
        --bind "alt-4:+reload(_fzf-man-reload 4)+change-preview(${batman})+change-prompt(man(4) Kernel Interfaces > )" \
        --bind "alt-5:+reload(_fzf-man-reload 5)+change-preview(${batman})+change-prompt(man(5) File Formats > )" \
        --bind "alt-6:+reload(_fzf-man-reload 6)+change-preview(${batman})+change-prompt(man(6) Games > )" \
        --bind "alt-7:+reload(_fzf-man-reload 7)+change-preview(${batman})+change-prompt(man(7) Misc Info > )" \
        --bind "alt-8:+reload(_fzf-man-reload 8)+change-preview(${batman})+change-prompt(man(8) System Manager's > )" \
        --bind "alt-9:+reload(_fzf-man-reload 9)+change-preview(${batman})+change-prompt(man(9) Kernel Developer's > )" \
        --bind "alt-t:+reload(tldr -l)+change-preview(tldr {1})+change-prompt(tldr > )"
    if [[ $ZLE_STATE == *widget* ]]; then
        [[ -o zle ]] && zle reset-prompt
    fi
}

# Register the widget
zle -N fzf-man

# Bind Ctrl-H to launch the fzf-man widget
bindkey '^h' fzf-man

