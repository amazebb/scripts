# Interactive man page/tldr searcher with fzf, bat, and key bindings

fzf-man() {
    cyan=$(tput setaf 6)
    blue=$(tput setaf 4)
    res=$(tput sgr0)
    bld=$(tput bold)
    color_awk='{ $1=cyan bld $1; $2=res blue $2; } 1'
    esc_cyan=$(printf '%q' "$cyan")
    esc_blue=$(printf '%q' "$blue")
    esc_res=$(printf '%q' "$res")
    esc_bld=$(printf '%q' "$bld")a
    manpage='echo {} |  awk -F"[()]" "{print \$2, \$1}" | xargs man'
    batman="$manpage | bat --style=plain --language=man --color always --theme auto:system"
    _fzf-man-reload | fzf -q "$1" --ansi --style full --tiebreak=begin \
        --header 'alt-m:man, alt-t:TLDR' \
        --prompt=' Man > ' \
        --preview-window '50%,rounded,<50(up,85%,border-bottom)' \
        --preview "$batman" \
        --bind "enter:execute($manpage)" \
        --bind "alt-m:+reload(_fzf-man-reload)+change-preview(${batman})+change-prompt( Man > )" \
        --bind "alt-t:+reload(tldr -l)+change-preview(tldr {1})+change-prompt(TLDR > )"
    if [[ $ZLE_STATE == *widget* ]]; then
        [[ -o zle ]] && zle reset-prompt
    fi
}
# --bind "alt-t:+reload(comm -12 <(tldr -l) <(man -k . | -F' - ' '!seen[$1]++ {print \$1}' | sort -u) | sort -r | awk -v cyan=${esc_cyan} -v blue=${esc_blue} -v res=${esc_res} -v bld=${esc_bld} '${color_awk}')+change-preview(tldr -C {1})+change-prompt(TLDR > )"

# Register the widget
zle -N fzf-man

# Bind Ctrl-H to launch the fzf-man widget
bindkey '^h' fzf-man

