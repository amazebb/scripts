#!/usr/bin/env bash
# shellcheck disable=SC2016
# Manage Gitea: start, stop, status, logs.

U() {
    tput smul
    printf '%s' "$*"
    tput rmul
}

B() {
    tput bold
    printf '%s' "$*"
    tput sgr0
}

I() {
    tput sitm
    printf '%s' "$*"
    tput ritm
}

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

info() { printf "\033[31m%s\033[0m\n" "$1" >&2; }

warn() { info "$1" && exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
}

noargs() { ((!$1)) && info "Error: no arguments provided" && usage && exit 1; }

usage() {
    cat <<EOF
$(B NAME)
    $(B gitea-cli) - Manage Gitea server operations

$(B SYNOPSIS)
    $(B "gitea-cli [-h]") $(U command)

$(B DESCRIPTION)
    Start, stop, check status, and view logs for a local Gitea server.

$(B COMMANDS)
    $(B start)     Start the Gitea server and open in Safari
    $(B stop)      Stop the Gitea server
    $(B status)    Show the Gitea running status
    $(B log)       Show Gitea server logs

$(B OPTIONS)
    $(B -h)        Show this help message

$(B EXAMPLES)
    Start the server

        gitea-cli start

    View live logs

        gitea-cli log

EOF
}

start_gitea() {
    if pgrep -f "gitea web" >/dev/null; then
        echo "Gitea is already running."
    else
        gitea web --config ~/.gitea-data/custom/conf/app.ini &
        until curl -s http://localhost:3000 >/dev/null; do
            sleep 1
        done
        echo "Gitea started."
    fi
    open -a Safari http://localhost:3000
}

stop_gitea() {
    if pgrep -f "gitea web" >/dev/null; then
        echo "Stopping Gitea..."
        pkill -INT -f "gitea web"
        echo "Gitea stopped"
    else
        echo "Gitea not running"
    fi
}

show_logs() {
    echo "Showing Gitea logs..."
    tail -f ~/.gitea-data/log/gitea.log | bat --paging=never -l log
}

status_gitea() {
    if pgrep -f "gitea web" >/dev/null; then
        echo "Gitea is running (PID: $(pgrep -f "gitea web"))"
    else
        echo "Gitea is not running"
    fi
}

noargs $#

while (($#)); do
    case "$1" in
    start) start_gitea ;;
    stop) stop_gitea ;;
    status) status_gitea ;;
    log) show_logs ;;
    -h | --help) usage && exit 0 ;;
    --) shift && break ;;
    *) warn "Unknown option: $1" ;;
    esac
    shift
done
