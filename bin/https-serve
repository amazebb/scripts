#!/usr/bin/env python3
"""Serve a directory over HTTPS with a mkcert certificate.

usage: https-serve [port] [dir]  ->  https://localhost:<port>/

Why HTTPS: Safari private browsing tries HTTPS first and refuses plain
http://localhost, so a plain `python -m http.server` hangs or fails.

One-time setup (mkcert, brew install mkcert):
  1. mkcert -install
     Creates a local CA (kept in `mkcert -CAROOT`, i.e.
     ~/Library/Application Support/mkcert) and adds it to the trust stores:
       "The local CA is now installed in the system trust store!"  (macOS
       keychain; Safari and curl use it; asks for sudo, so run it in a real
       terminal)
       "The local CA is now installed in Java's trust store!"  (only if a
       JDK is found)
     Relaunch Safari afterwards so it picks up the new root.
  2. mkcert localhost 127.0.0.1 ::1
     Writes localhost+2.pem (cert) and localhost+2-key.pem (private key) to
     the current directory. Move them to ~/.config/mkcert-localhost/
     (CERT_DIR below), outside any repo, so the key is never committed.
     Never share the key or the CA's rootCA-key.pem.

Binds IPv6 and IPv4 (dual stack) so https://localhost and
https://127.0.0.1 both work.
"""

import functools
import http.server
import os
import socket
import ssl
import sys

CERT_DIR = os.path.expanduser("~/.config/mkcert-localhost")


class DualStackServer(http.server.ThreadingHTTPServer):
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


def main():
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8000
    root = sys.argv[2] if len(sys.argv) > 2 else os.getcwd()

    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(
        os.path.join(CERT_DIR, "localhost+2.pem"),
        os.path.join(CERT_DIR, "localhost+2-key.pem"),
    )

    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=root)
    server = DualStackServer(("::", port), handler)
    server.socket = ctx.wrap_socket(server.socket, server_side=True)

    print(f"https://localhost:{port}/")
    server.serve_forever()


if __name__ == "__main__":
    main()
