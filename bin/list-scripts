#!/usr/bin/env bash
# List scripts with descriptions in $HOME/.local/share/scripts/bin
U() { printf '\e[4m%s\e[0m' "$*"; }

B() { printf '\e[1m%s\e[0m' "$*"; }

I() { printf '\e[3m%s\e[0m' "$*"; }

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

color() {
    local name=$1
    shift
    local code
    case $name in
    RED) code=31 ;;
    GREEN) code=32 ;;
    YELLOW) code=33 ;;
    BLUE) code=34 ;;
    MAGENTA) code=35 ;;
    CYAN) code=36 ;;
    *) code=0 ;;
    esac
    printf '\e[%sm%s\e[0m' "$code" "$*"
}

msg() { printf '%s\n' "$(color "$2" "$1")" >&2; }

info() { msg "$1" BLUE; }

warn() { msg "$1" RED && exit 1; }

usage() {
    cat <<EOF
$(B NAME)
    $(B list-scripts) - List user scripts

$(B SYNOPSIS)
    $(B "list-scripts [-h] [-c]") [$(U script_directory)]

$(B DESCRIPTION)
    List scripts with description and optionally warn if there are issues
    $(U script_directory) defaults to $(I \$HOME/.local/share/scripts/bin)

$(B OPTIONS)
    $(B -h) Show this help message

    $(B -c) Check for any issues

$(B EXAMPLES)
    List all scripts and check for any issues

        list-scripts -c

EOF
}

CHECK=0

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -c)
        CHECK=1
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

# Directory to search for script
DIR=${1:-$HOME/.local/share/scripts/bin}

# Find all shell script files and process them
A=(NAME)
B=(SHELL)
C=(DESCRIPTION)
D=(STATUS)

check_scripts() {
    if [[ ! "$1" =~ \.[^/]*$ ]]; then
        output=$(shellcheck "$1" 2>/dev/null)
    elif [[ "$1" =~ \.awk ]]; then
        output=$(gawk --lint -f "$1" </dev/null 2>&1 | grep -i warning)
    fi
    [[ -n "$output" ]] && echo "WARN" || echo " "
}

while read -r script; do
    # Get the script name (basename removes the path)
    A+=("$(basename "$script")")

    if [[ "$script" =~ \.awk ]]; then
        B+=(awk)
    else
        # Determine script type from shebang or vim modeline
        first_line=$(head -n 1 "$script")
        if [[ "$first_line" == "#!"* ]]; then
            B+=("${first_line//#!\/usr\/bin\/env /}")
        elif [[ "$first_line" =~ vim:.*ft=([a-z]+) ]]; then
            B+=("${BASH_REMATCH[1]}")
        else
            B+=("unknown")
        fi
    fi

    # Extract the first comment line that starts with # (ignoring shebang and # vim:)
    desc=$(grep -v -E '^#(!| ?vim:)' "$script" | head -n 1 | sed 's/^# *//')

    # If no description found, use a placeholder
    desc=${desc:-"No description"}
    C+=("$desc")

    if ((CHECK)); then
        status=$(check_scripts "$script")
        D+=("$status")
    fi
done < <(find "$DIR" -type f -depth 1 | sort -k1)

if ((CHECK)); then
    paste <(printf '%s\n' "${A[@]}") \
        <(printf '%s\n' "${B[@]}") \
        <(printf '%s\n' "${D[@]}") \
        <(printf '%s\n' "${C[@]}") | column -s $'\t' -t
else
    paste <(printf '%s\n' "${A[@]}") \
        <(printf '%s\n' "${B[@]}") \
        <(printf '%s\n' "${C[@]}") | column -s $'\t' -t
fi
