#!/usr/bin/env bash
# List scripts with descriptions in $HOME/.local/share/scripts/bin

# shellcheck disable=SC2016
source "$(dirname "$0")/common.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B list-scripts) - List user scripts

$(B SYNOPSIS)
    $(B "list-scripts [-h] [-c]") [$(U script_directory)]

$(B DESCRIPTION)
    List scripts with description and optionally warn if there are issues
    $(U script_directory) defaults to $(I \$HOME/.local/share/scripts/bin)

$(B OPTIONS)
    $(B -h) Show this help message

    $(B -c) Check for any issues, marking a script $(B WARN) when its
       checker reports anything. The checker depends on the file type
       shown in the $(B SHELL) column, since one linter does not cover
       them all:

           bash, sh, dash, ksh   $(B "shellcheck -x") $(I '(-x follows sourced files)')
           zsh                   $(B "zsh -n"), a syntax check only, as
                                 $(B shellcheck) cannot parse zsh
           awk                   $(B "gawk --lint=no-ext"), filtered to
                                 warnings. $(I no-ext) permits gawk
                                 extensions, which the scripts here rely on

$(B EXAMPLES)
    List all scripts and check for any issues

        list-scripts -c

EOF
}

CHECK=0

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -c)
        CHECK=1
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

# Directory to search for script
DIR=${1:-$HOME/.local/share/scripts/bin}

# Find all shell script files and process them
A=(NAME)
B=(SHELL)
C=(DESCRIPTION)
D=(STATUS)

# $1=script, $2=shell as reported in the SHELL column.
# zsh gets a syntax check only, as ShellCheck cannot parse it. For the
# rest, -x follows sourced files so common.sh does not trip SC1091.
check_scripts() {
    local output
    case $2 in
    awk) output=$(gawk --lint=no-ext -f "$1" </dev/null 2>&1 | grep -i warning) ;;
    zsh) output=$(zsh -n "$1" 2>&1) ;;
    bash | sh | dash | ksh) output=$(shellcheck -x "$1" 2>/dev/null) ;;
    *) output= ;;
    esac
    [[ -n "$output" ]] && echo "WARN" || echo " "
}

while read -r script; do
    # Get the script name (basename removes the path)
    A+=("$(basename "$script")")

    if [[ "$script" =~ \.awk ]]; then
        shell="awk"
    else
        # Determine script type from shebang or vim modeline
        first_line=$(head -n 1 "$script")
        if [[ "$first_line" == "#!"* ]]; then
            shell="${first_line//#!\/usr\/bin\/env /}"
        elif [[ "$first_line" =~ vim:.*ft=([a-z]+) ]]; then
            shell="${BASH_REMATCH[1]}"
        else
            shell="unknown"
        fi
    fi
    B+=("$shell")

    # Extract the first comment line that starts with # (ignoring shebang and # vim:)
    desc=$(grep -v -E '^#(!| ?vim:)' "$script" | head -n 1 | sed 's/^# *//')

    # If no description found, use a placeholder
    desc=${desc:-"No description"}
    C+=("$desc")

    if ((CHECK)); then
        status=$(check_scripts "$script" "$shell")
        D+=("$status")
    fi
done < <(find "$DIR" -type f -depth 1 | sort -k1)

if ((CHECK)); then
    paste <(printf '%s\n' "${A[@]}") \
        <(printf '%s\n' "${B[@]}") \
        <(printf '%s\n' "${D[@]}") \
        <(printf '%s\n' "${C[@]}") | column -s $'\t' -t
else
    paste <(printf '%s\n' "${A[@]}") \
        <(printf '%s\n' "${B[@]}") \
        <(printf '%s\n' "${C[@]}") | column -s $'\t' -t
fi
