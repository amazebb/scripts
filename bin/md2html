#!/usr/bin/env python3
"""Convert a markdown page into an HTML page from a template.

usage: md2html [-T TEMPLATE] [-a ANCHORS.html] [-o OUT] FILE.md

  -T  page template (default: a minimal built-in page)
  -a  an HTML page whose ids are link targets, e.g. the man2html output; code spans such as
      NNN_PILL=0 or -G then link to ANCHORS#NNN_PILL / ANCHORS#opt-G when that id exists
  -o  output file (default: FILE with .html)

Template placeholders: @BODY@ (the converted markdown), @include(file)@ (a file next to the
template), and one pair per front matter key: @KEY@ (upper case: the plain text, escaped) and
@key@ (lower case: inline markdown).

Markdown: front matter (--- key: value ---), headings with {#id .class}, paragraphs, lists, pipe
tables, fenced code (sh blocks get a Copy button), inline code/links/bold/emphasis, raw HTML
blocks and inline tags. Extras:

  ## Title {#id .cards}     a section; the first paragraph is its lede. With .cards every ###
                            below it is a card (### Title {.wide}); elsewhere ### is a sub heading.
  ::: tags / details / note a container, closed by :::  (tags: comma separated, !x marks a new one;
                            details: the argument is the summary)
  {{include FILE#slug}}     the content of that section of another markdown file
  {{table FILE#slug [N]}}   the Nth (default 1st) table of that section
  {{code FILE#slug [N]}}    the Nth code block of that section

In a table whose first header is "Key", code spans in the first column are drawn as <kbd>. Any
link to ANCHORS#id or to an in-page #id that does not exist is reported and the exit status is 1.
"""
import argparse
import html
import re
import sys
from pathlib import Path

DEFAULT = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@TITLE@</title>
</head>
<body>
@BODY@
</body>
</html>
"""

BLOCK_HTML = re.compile(r"<(div|figure|section|details|p|ul|ol|table|pre|!--|header|nav|h[1-6]|img|svg|script|style)\b")
FENCE = re.compile(r"^(`{3,})\s*(\S*)\s*$")
HEADING = re.compile(r"^(#{1,6})\s+(.*?)(?:\s+\{([^}]*)\})?\s*$")
DIRECTIVE = re.compile(r"^\{\{(include|table|code)\s+(\S+)(?:\s+(\d+))?\}\}$")
SEPARATOR = re.compile(r"^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?$")
CONTAINER = re.compile(r"^:::\s*(\w+)\s*(.*?)\s*$")
LIST = re.compile(r"^[-*]\s+")
HTML_INLINE = re.compile(r"</?[a-zA-Z][^<>]*>|&(?:[a-zA-Z]+|#\d+);")

anchors = set()
problems = []


def slug(text):
    """GitHub's heading slug: lower case, drop punctuation, spaces to hyphens."""
    text = re.sub(r"[`*]", "", text).lower()
    return re.sub(r"[^\w\- ]", "", text).replace(" ", "-")


def esc(t):
    return html.escape(t, quote=False)


def kbd(t):
    if t == ";;":
        return "<kbd>;</kbd><kbd>;</kbd>"
    if len(t) > 1 and "+" in t.strip("+"):
        return "+".join(f"<kbd>{esc(p)}</kbd>" for p in t.split("+"))
    return f"<kbd>{esc(t)}</kbd>"


def code(t, autolink, as_kbd):
    if as_kbd:
        return kbd(t)
    out = f'<code class="nowrap">{esc(t)}</code>' if re.match(r"^-[\w-]{2,}$", t) else f"<code>{esc(t)}</code>"  # keep -lfoo whole
    if autolink:
        m = re.match(r"^(NNN_[A-Z0-9_]+)(=.*)?$", t) or re.match(r"^-([A-Za-z0-9])$", t)
        if m:
            ident = m.group(1) if t.startswith("NNN_") else "opt-" + m.group(1)
            if ident in anchors:
                return f'<a href="man.html#{ident}">{out}</a>'
    return out


def inline(text, autolink=True, as_kbd=False):
    stash = []

    def keep(item):
        stash.append(item)
        return f"\x00{len(stash) - 1}\x00"

    def resolve(s, link):
        """Put the stashed pieces back; code spans become links to the manual unless inside a link."""
        def one(m):
            kind, val = stash[int(m.group(1))]
            return code(val, autolink and not link, as_kbd) if kind == "code" else val
        while "\x00" in s:
            s = re.sub(r"\x00(\d+)\x00", one, s)
        return s

    text = re.sub(r"(`+)(.+?)\1", lambda m: keep(("code", m.group(2).strip())), text)
    text = HTML_INLINE.sub(lambda m: keep(("html", m.group(0))), text)
    text = re.sub(
        r"\[([^\]]+)\]\(([^)\s]+)\)",
        lambda m: keep(("html", f'<a href="{html.escape(m.group(2))}">{resolve(esc_keep(m.group(1)), True)}</a>')),
        text,
    )
    text = re.sub(r"\*\*(\S(?:.*?\S)?)\*\*", lambda m: keep(("html", f"<strong>{resolve(esc_keep(m.group(1)), False)}</strong>")), text)
    text = re.sub(r"(?<![\w*])\*(\S(?:.*?\S)?)\*(?![\w*])", lambda m: keep(("html", f"<em>{resolve(esc_keep(m.group(1)), False)}</em>")), text)
    return resolve(esc_keep(text), False)


def esc_keep(t):
    """Escape text but leave the \\x00N\\x00 stash markers alone."""
    return esc(t)


def cells(line):
    line = line.strip().strip("|")
    return [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", line)]


def attrs(raw):
    ident, classes = "", []
    for w in (raw or "").split():
        if w.startswith("#"):
            ident = w[1:]
        elif w.startswith("."):
            classes.append(w[1:])
    return ident, classes


def read_section(path, frag):
    """The lines under the heading whose slug is FRAG, up to the next heading of the same or a higher level."""
    lines = Path(path).read_text().split("\n")
    out, level, fenced = None, 0, False
    for line in lines:
        if FENCE.match(line):
            fenced = not fenced
        m = None if fenced else HEADING.match(line)
        if out is None:
            if m and slug(m.group(2)) == frag:
                out, level = [], len(m.group(1))
            continue
        if m and len(m.group(1)) <= level:
            break
        out.append(line)
    if out is None:
        sys.exit(f"md2html: no section #{frag} in {path}")
    return out


def tokenize(lines, base):
    """Lines to a list of tokens: (kind, ...)."""
    toks, i, n = [], 0, len(lines)
    while i < n:
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        m = DIRECTIVE.match(line.strip())
        if m:
            kind, target, num = m.group(1), m.group(2), int(m.group(3) or 1)
            path, _, frag = target.partition("#")
            sub = tokenize(read_section(base / path, frag), (base / path).parent)
            if kind == "include":
                toks += sub
            else:
                want = "table" if kind == "table" else "code"
                found = [t for t in sub if t[0] == want]
                if len(found) < num:
                    sys.exit(f"md2html: no {want} {num} in {target}")
                toks.append(found[num - 1])
            i += 1
            continue
        m = FENCE.match(line)
        if m:
            i += 1
            body = []
            while i < n and not lines[i].startswith(m.group(1)):
                body.append(lines[i])
                i += 1
            toks.append(("code", m.group(2), "\n".join(body)))
            i += 1
            continue
        m = CONTAINER.match(line)
        if m and m.group(1):
            i += 1
            body = []
            while i < n and lines[i].strip() != ":::":
                body.append(lines[i])
                i += 1
            toks.append(("box", m.group(1), m.group(2), tokenize(body, base), "\n".join(body)))
            i += 1
            continue
        m = HEADING.match(line)
        if m:
            toks.append(("h", len(m.group(1)), m.group(2), attrs(m.group(3))))
            i += 1
            continue
        if line.lstrip().startswith("|") and i + 1 < n and SEPARATOR.match(lines[i + 1].strip()):
            head = cells(line)
            i += 2
            rows = []
            while i < n and lines[i].lstrip().startswith("|"):
                rows.append(cells(lines[i]))
                i += 1
            toks.append(("table", head, rows))
            continue
        if LIST.match(line):
            items = []
            while i < n and LIST.match(lines[i]):
                item = [LIST.sub("", lines[i])]
                i += 1
                while i < n and lines[i].startswith("  ") and lines[i].strip():
                    item.append(lines[i].strip())
                    i += 1
                items.append(" ".join(item))
            toks.append(("ul", items))
            continue
        if BLOCK_HTML.match(line.lstrip()):
            body = []
            while i < n and lines[i].strip():
                body.append(lines[i])
                i += 1
            toks.append(("html", "\n".join(body)))
            continue
        body = []
        while i < n and lines[i].strip() and not (
            FENCE.match(lines[i]) or HEADING.match(lines[i]) or CONTAINER.match(lines[i])
            or DIRECTIVE.match(lines[i].strip()) or LIST.match(lines[i])
        ):
            body.append(lines[i].strip())
            i += 1
        toks.append(("p", " ".join(body)))
    return toks


def render_table(head, rows):
    keys = head[0].lower() == "key"
    out = ['<div class="table-wrap">', "<table>", "<thead><tr>" + "".join(f"<th>{inline(h)}</th>" for h in head) + "</tr></thead>", "<tbody>"]
    for r in rows:
        tds = "".join(f"<td>{inline(c, True, keys and k == 0)}</td>" for k, c in enumerate(r))
        out.append(f"<tr>{tds}</tr>")
    out += ["</tbody>", "</table>", "</div>"]
    return "\n".join(out)


def render_block(t, lede=False):
    kind = t[0]
    if kind == "p":
        return f'<p class="lede">{inline(t[1])}</p>' if lede else f"<p>{inline(t[1])}</p>"
    if kind == "table":
        return render_table(t[1], t[2])
    if kind == "code":
        if t[1] in ("sh", "bash", "console", "shell"):
            return f'<div class="codeblock">\n<button class="copy" type="button">Copy</button>\n<pre>{esc(t[2])}</pre>\n</div>'
        return f"<pre><code>{esc(t[2])}</code></pre>"
    if kind == "ul":
        return "<ul>\n" + "\n".join(f"<li>{inline(x)}</li>" for x in t[1]) + "\n</ul>"
    if kind == "html":
        return t[1]
    if kind == "box":
        name, arg, inner, raw = t[1], t[2], t[3], t[4]
        if name == "tags":
            spans = []
            for item in [x.strip() for x in raw.replace("\n", " ").split(",") if x.strip()]:
                new = item.startswith("!")
                label = inline(item.lstrip("!"))
                spans.append(f'<span class="new">{label}</span>' if new else f"<span>{label}</span>")
            return '<div class="tags">' + "".join(spans) + "</div>"
        if name == "details":
            return f'<details class="reqs">\n<summary>{inline(arg)}</summary>\n{render(inner)}\n</details>'
        if name == "note":
            return f'<p class="note">{inline(" ".join(raw.split()))}</p>'
        sys.exit(f"md2html: unknown container ::: {name}")
    return ""


def render(toks):
    out, section, cards, card, first = [], False, False, False, False

    def close_card():
        nonlocal card
        if card:
            out.append("</div>")
            card = False

    def close_section():
        nonlocal section, cards
        close_card()
        if cards:
            out.append("</div>")
            cards = False
        if section:
            out.append("</section>")
            section = False

    in_cards = False
    for t in toks:
        if t[0] == "h" and t[1] == 2:
            close_section()
            ident, classes = t[3]
            in_cards = "cards" in classes
            out.append(f'<section id="{ident or slug(t[2])}">')
            out.append(f"<h2>{inline(t[2], False)}</h2>")
            section, first = True, True
            continue
        if t[0] == "h" and t[1] == 3 and in_cards:
            close_card()
            if not cards:
                out.append('<div class="cards">')
                cards = True
            ident, classes = t[3]
            cls = " ".join(["card"] + classes)
            out.append(f'<div class="{cls}">')
            card = True
            out.append(f"<h3>{inline(t[2], False)}</h3>")
            continue
        if t[0] == "h":
            out.append(f'<h3 class="sub">{inline(t[2], False)}</h3>' if t[1] >= 3 else f"<h{t[1]}>{inline(t[2], False)}</h{t[1]}>")
            first = False
            continue
        out.append(render_block(t, lede=first and t[0] == "p"))
        first = False
    close_section()
    return "\n".join(out)


def front_matter(text):
    meta = {}
    if text.startswith("---\n"):
        head, _, rest = text[4:].partition("\n---\n")
        key = None
        for line in head.split("\n"):
            m = re.match(r"^(\w+):\s*(.*)$", line)
            if m:
                key = m.group(1)
                meta[key] = m.group(2)
            elif key and line.strip():
                meta[key] += " " + line.strip()
        return meta, rest
    return meta, text


def fill(template, tdir, meta, body):
    template = re.sub(r"@include\(([^)]+)\)@", lambda m: (tdir / m.group(1)).read_text().rstrip("\n"), template)
    for k, v in meta.items():
        template = template.replace(f"@{k.upper()}@", esc(v)).replace(f"@{k}@", inline(v))
    return template.replace("@BODY@", body)


def check(page):
    ids = set(re.findall(r'\bid="([^"]+)"', page))
    for href in sorted(set(re.findall(r'href="([^"]+)"', page))):
        if href.startswith("man.html#") and anchors and href[9:] not in anchors:
            problems.append(f"no such manual anchor: {href}")
        elif href.startswith("#") and len(href) > 1 and href[1:] not in ids:
            problems.append(f"no such anchor on the page: {href}")


def main():
    ap = argparse.ArgumentParser(description="markdown to an HTML page")
    ap.add_argument("mdfile")
    ap.add_argument("-T", dest="template")
    ap.add_argument("-a", dest="anchors")
    ap.add_argument("-o", dest="out")
    a = ap.parse_args()

    src = Path(a.mdfile)
    if not src.is_file():
        sys.exit(f"md2html: {src} not found")
    if a.anchors:
        anchors.update(re.findall(r'\bid="([^"]+)"', Path(a.anchors).read_text()))
    meta, text = front_matter(src.read_text())
    text = re.sub(r"<!--.*?-->\n?", "", text, flags=re.S)  # comments are for the author
    body = render(tokenize(text.split("\n"), src.parent))
    tpl = Path(a.template) if a.template else None
    page = fill(tpl.read_text() if tpl else DEFAULT, tpl.parent if tpl else src.parent, meta, body)
    page = re.sub(r"^(<!doctype html>)", rf"\1\n<!-- generated by md2html from {src.name}: edit that, not this file -->", page, count=1, flags=re.I)
    check(page)
    dest = Path(a.out) if a.out else src.with_suffix(".html")
    dest.write_text(page if page.endswith("\n") else page + "\n")
    print(f"wrote {dest}")
    for p in problems:
        print(f"md2html: {p}", file=sys.stderr)
    sys.exit(1 if problems else 0)


if __name__ == "__main__":
    main()
