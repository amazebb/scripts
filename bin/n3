#!/usr/bin/env bash
# Launch nnn with preview-tui (Ghostty native split, or tmux)

# shellcheck disable=SC2016
# shellcheck source=common.sh
source "$(dirname "$0")/common.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B n3) - Launch nnn with preview-tui

$(B SYNOPSIS)
    $(B "n3 [-h] [-t]") [$(U nnn-args)...]

$(B DESCRIPTION)
    Launches $(B nnn) with the preview-tui plugin.
    In Ghostty 1.3+, preview-tui opens a native split (Cmd+D /
    new_split:right) via a dedicated AppleScript. Kitty uses native
    splits. Pass $(B -t) or set $(B N3_TMUX=1) to wrap nnn in tmux
    instead. Refuses to run when already inside an nnn subshell.
    Extra arguments are forwarded to $(B nnn).

    On quit, cds into the directory $(B nnn) was last in via $(I NNN_TMPFILE).

$(B OPTIONS)
    $(B -h)    Show this help message
    $(B -t)    Use tmux for the preview split (also $(B N3_TMUX=1))

$(B EXAMPLES)
    Open in current directory

        n3

    Open with a tmux preview split

        n3 -t

    Open at a specific path

        n3 ~/projects

EOF
}

use_tmux=0
[[ -n ${N3_TMUX:-} ]] && use_tmux=1

while (($#)); do
    case $1 in
    -h)
        usage
        exit 0
        ;;
    -t)
        use_tmux=1
        shift
        ;;
    --)
        shift
        break
        ;;
    *) break ;;
    esac
done

[[ ${NNNLVL:-0} -eq 0 ]] || warn "nnn is already running"

# undim inactive kitty windows so the preview pane is readable
if [ -n "$KITTY_WINDOW_ID" ]; then
    kitten @ load-config --override inactive_text_alpha=1.0 2>/dev/null
    trap 'kitten @ load-config 2>/dev/null' EXIT INT TERM
fi

# The default behaviour is to cd on quit (nnn checks if NNN_TMPFILE is set)
# If NNN_TMPFILE is set to a custom path, it must be exported for nnn to see.
# To cd on quit only on ^G, remove the "export" and set NNN_TMPFILE *exactly* as this:
export NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"

NNN_FIFO="$(mktemp -t nnn.XXXXXX -u)"
export NNN_FIFO
(
    umask 077
    mkfifo "$NNN_FIFO"
)

export NNN_PLUG='p:preview-tui'

# Default: nnn in this terminal; preview-tui uses Ghostty AppleScript
# (or kitty/wezterm). -t / N3_TMUX=1 wraps nnn in tmux instead.
if [[ $use_tmux -eq 1 && -z ${TMUX:-} ]]; then
    command -v tmux >/dev/null || warn "tmux is required for n3 -t"
    tmux new-session -c "$PWD" -- env \
        NNN_FIFO="$NNN_FIFO" \
        NNN_TMPFILE="$NNN_TMPFILE" \
        NNN_PLUG="$NNN_PLUG" \
        nnn -dIYGaPp "$@"
else
    nnn -dIYGaPp "$@"
fi

plugdir="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/plugins"
if [[ -f $plugdir/preview-ghostty-close.applescript ]]; then
    for idfile in "${TMPDIR:-/tmp}"/nnn-preview-tui-ghosttyid.*; do
        [[ -f $idfile ]] || continue
        osascript "$plugdir/preview-ghostty-close.applescript" "$(cat "$idfile")" >/dev/null 2>&1
        rm -f -- "$idfile"
    done
fi

# shellcheck source=/dev/null
[[ ! -f $NNN_TMPFILE ]] || {
    . "$NNN_TMPFILE"
    rm -f -- "$NNN_TMPFILE" >/dev/null
}

# restore original config to restore inactive window text dimming
if [ -n "$KITTY_WINDOW_ID" ]; then
    kitten @ load-config 2>/dev/null
    trap - EXIT INT TERM
fi

rm -f "$NNN_FIFO"
