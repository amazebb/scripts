#!/usr/bin/env bash
# shellcheck disable=SC2016
# shellcheck source=common.sh
source "$(dirname "$0")/common.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B n3) - Launch nnn with tmux preview pane

$(B SYNOPSIS)
    $(B "n3 [-h]") [$(U nnn-args)...]

$(B DESCRIPTION)
    Launches $(B nnn) with the preview-tui plugin in a tmux split pane.
    Refuses to run when already inside an nnn subshell. Any extra
    arguments are forwarded to $(B nnn).

    On quit, cds into the directory $(B nnn) was last in via $(I NNN_TMPFILE).

$(B OPTIONS)
    $(B -h)    Show this help message

$(B EXAMPLES)
    Open in current directory

        n3

    Open at a specific path

        n3 ~/projects

EOF
}

while (($#)); do
    case $1 in
        -h) usage; exit 0 ;;
        --) shift; break ;;
        *)  break ;;
    esac
    shift
done

[[ ${NNNLVL:-0} -eq 0 ]] || warn "nnn is already running"

# The default behaviour is to cd on quit (nnn checks if NNN_TMPFILE is set)
# If NNN_TMPFILE is set to a custom path, it must be exported for nnn to see.
# To cd on quit only on ^G, remove the "export" and set NNN_TMPFILE *exactly* as this:
#     NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"
export NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"

NNN_FIFO="$(mktemp -t nnn.XXXXXX -u)"
export NNN_FIFO
(
    umask 077
    mkfifo "$NNN_FIFO"
)

export NNN_PLUG='p:preview-tui'

if [[ -e ${TMUX%%,*} ]]; then
    tmux split-window -e "NNN_FIFO=$NNN_FIFO" -dh _nnn_preview
fi

nnn -d -G -a -Pp "$@"

# shellcheck source=/dev/null
[[ ! -f $NNN_TMPFILE ]] || {
    . "$NNN_TMPFILE"
    rm -f -- "$NNN_TMPFILE" >/dev/null
}

rm -f "$NNN_FIFO"
