#!/usr/bin/env bash

# shellcheck disable=SC2016

usage() {
    cat <<EOF
$(B NAME)
    $(B rawdupes) - Find duplicate files and offer to create symlinks

$(B SYNOPSIS)
    $(B "rawdupes [-h] [-e | -s | -w]") $(U search_directory)
    $(B "rawdupes -f") $(U hash_file)

$(B DESCRIPTION)
    Find duplicate files and offer to create symlinks.
    The search results including hash, filename and size are written to file.

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -e) [$(U ext)]  Extensions to process ignoring-case $(I '(default: all files)')
    
    $(B -s) $(U sym)    Preferred folder source for symlinks ($(I 'default: none specified'))
    
    $(B -w) [$(U file)] Output of duplicate search results ($(I 'default: $PWD/files.hash)') 
    
    $(B -f) $(U file)   Analyze previously generated search results file

    Zero byte files are ignored in the search.

$(B EXAMPLES)
    Find all duplicate Sony RAW images (ARW) searching recursively from current directory

        rawdupes -e arw .

EOF
}

warn() {
    if [ $# -ne 0 ]; then
        printf "\033[31m%s\033[0m\n" "$1" >&2
    fi
    (($# < 2)) && exit 1 || ([[ "$2" == "-1" ]] && return 0) || exit "${2:-1}"
}

U() {
    printf "%s" "$(tput smul)$1$(tput rmul)"
}

B() {
    printf "%s" "$(tput bold)$1$(tput sgr0)"
}

I() {
    printf "%s" "$(tput sitm)$1$(tput ritm)"
}

((!$#)) && warn "Error: no arguments provided" -1 && usage && exit 1

Q() {
    read -p "$1 [y/n]: " -r
    echo
    if [[ ! $REPLY =~ [Yy] ]]; then
        echo "Aborted."
        exit 1
    fi
}

ask() {
    read -p "$1: " -r
    echo "$REPLY"
}

argval() {
    if (($# < 2)); then
        # NOTE since 'warn' is called in a sub-shell the exit 1 does not exit
        # immediately, so the below parse args while loop will cycle through
        # all entered args.
        warn "Error: $1 requires an argument"
    fi
    echo "$2"
}

typeset -A var
var[-s]=''
var[-e]=''
var[-w]="$PWD/files.hash"
run_hash=true

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -e | -s | -w | -f)
        # Append '|| exit 1' to exit on first bad arg.
        var["$1"]=$(argval "$@")
        [[ "$1" == "-f" ]] && run_hash=false
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

EXT="${var[-e]}"
SYM=$(realpath "${var[-s]}" 2>/dev/null)
FILE="${var[-w]}"

if ((!$#)) && $run_hash; then
    warn "Error: source_directory required"
elif $run_hash; then
    SEARCH_DIR="$1"
elif ! $run_hash; then
    FILE="${var[-f]}"
fi

if $run_hash; then
    [[ "$EXT" != "" ]] &&
        files=$(fd -a -tf -e "$EXT" -S +1b -X du -b \; "$SEARCH_DIR") ||
        files=$(fd -a -tf -S +1b -X du -b \; "$SEARCH_DIR")

    sz=$(awk '{sum+=$1} 
END {
    if (sum >= 1024*1024*1024) printf "%.1f GiB\n", sum/1024/1024/1024
    else if (sum >= 1024*1024)   printf "%.1f MiB\n", sum/1024/1024
    else if (sum >= 1024)        printf "%.1f KiB\n", sum/1024
    else                         printf "%d Bi\n", sum
  }' <<<"$files")

    Q "Find duplicate ${EXT^^} [$(echo "$files" | wc -l) files ($sz)] ?"
    echo "$files" | cut -f2- | rapidhash -j 40 -s -p |
        sort -n -k3 -t $'\t' >"$FILE.tmp" && mv "$FILE.tmp" "$FILE"
    echo "File hashes written to $FILE"
fi

awk -F'\t' -v PREF_DUPE_DIR="$SYM" -v DRY_RUN="yes" \
    -f "$(dirname "$(realpath "$0")")/process-dupes.awk" "$FILE"

echo
Q "Do you wish to symlink these files ?"

while [[ "$SYM" == "" ]]; do
    SYM=$(ask "Enter preferred target directory, can be relative or\
 fullpath (CTRL-C to cancel)")
    [[ $SYM == "" ]] && continue

    SYM=$(realpath "$SYM")
    [[ ! -d "$SYM" ]] && echo "$SYM Not a valid directory" && SYM=""
    echo
done

run=$(ask "Use $SYM as preferred symlink target ? [y/n/d (dry-run)]")
[[ "$run" == "y" || "$run" == "d" ]] &&
    awk -F'\t' -v PREF_DUPE_DIR="$SYM" -v DRY_RUN="$run" \
        -f "$(dirname "$(realpath "$0")")/process-dupes.awk" "$FILE"
