#!/usr/bin/env bash

# shellcheck disable=SC2016

usage() {
    (($#)) && echo "$1" >&2

    cat <<EOF
$(B NAME)
    $(B rawdupes) - Find duplicate RAW images and cleanup

$(B SYNOPSIS)
    $(B "rawdupes [-h] [-e | -s]") $(U search_directory)
    $(B "rawdupes -f") [$(U hash_file)]

$(B DESCRIPTION)
    Find RAW duplicate images and offer to create symlinks

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -e) $(U ext)    Extensions to process $(I '(default: arw)')
    
    $(B -s) $(U sym)    Preferred folder source for symlinks ($(I 'default: $HOME/Pictures/by-date'))
    
    $(B -f) [$(U file)] Analyze previously generated hash file ($(I 'default: $PWD/files.hash'))

$(B EXAMPLES)
    Find all duplicate RAW images searching recursively from current directory

        rawdupes .

EOF
    exit 0
}

U() {
    printf "%s" "$(tput smul)$1$(tput rmul)"
}

B() {
    printf "%s" "$(tput bold)$1$(tput sgr0)"
}

I() {
    printf "%s" "$(tput sitm)$1$(tput ritm)"
}

((!$#)) && usage

Q() {
    read -p "$1 [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ [Yy] ]]; then
        echo "Aborted."
        exit 1
    fi
}

argval() {
    if (($# < 2)); then
        usage "Error: $1 requires an argument"
    fi
    echo "$2"
}

typeset -A var
var[-s]="$HOME/Pictures/by-date"
var[-e]='arw'
var[-f]="files.hash"
run_hash=true

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage ;;
    -f) run_hash=false ;;
    -e | -s)
        var["$1"]=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        usage "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

EXT="${var[-e]}"
SYM="${var[-s]}"

if ((!$#)) && $run_hash; then
    usage "Error: source_directory required"
elif $run_hash; then
    SEARCH_DIR="$1"
elif (($#)) && ! $run_hash; then
    FILE="$1"
elif ((!$#)) && ! $run_hash; then
    FILE="$PWD/files.hash"
fi

# shift
if $run_hash; then
    files=$(fd "$SEARCH_DIR" -a -t f -e "$EXT" -X du -b)
    awk '{sum+=$1; n++} END {print sum/1024/1024/1024 " GB  (" n " files)"}' <<<"$files"

    Q "Perform a file hash on the above files?"
    echo "$files" | cut -f2- | rapidhash -j 40 -s -p >files.hash
    echo "File hashes written to $PWD/files.hash"
fi

awk -F'\t' -v prefer="$SYM" \
    -f "$(dirname "$(realpath "$0")")/process-dupes.awk" "$FILE"
