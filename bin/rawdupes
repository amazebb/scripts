#!/usr/bin/env bash

# shellcheck disable=SC2016

usage() {
    if [ $# -ne 0 ]; then
        printf "\033[31m%s\033[0m\n" "$1" >&2
        exit 1
    fi

    cat <<EOF
$(B NAME)
    $(B rawdupes) - Find duplicate RAW images and cleanup

$(B SYNOPSIS)
    $(B "rawdupes [-h] [-e | -s | -w]") $(U search_directory)
    $(B "rawdupes -f") $(U hash_file)

$(B DESCRIPTION)
    Find RAW duplicate images and offer to create symlinks.
    The search results including hash, filename and size are written to file.

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -e) [$(U ext)]  Extensions to process, ignore-case $(I '(default: ARW)')
    
    $(B -s) [$(U sym)]  Preferred folder source for symlinks ($(I 'default: $HOME/Pictures/by-date'))
    
    $(B -w) [$(U file)] Output of duplicate search results ($(I 'default: $PWD/files.hash)') 
    
    $(B -f) $(U file)   Analyze previously generated search results file


$(B EXAMPLES)
    Find all duplicate RAW images searching recursively from current directory

        rawdupes .

EOF
    exit 0
}

U() {
    printf "%s" "$(tput smul)$1$(tput rmul)"
}

B() {
    printf "%s" "$(tput bold)$1$(tput sgr0)"
}

I() {
    printf "%s" "$(tput sitm)$1$(tput ritm)"
}

((!$#)) && usage

Q() {
    read -p "$1 [y/n] " -n 1 -r
    echo
    if [[ ! $REPLY =~ [Yy] ]]; then
        echo "Aborted."
        exit 1
    fi
}

argval() {
    if (($# < 2)); then
        # NOTE since 'usage' is called in a sub-shell the exit 1 does not exit
        # immediately, so the below parse args while loop will cycle through
        # all entered args.
        usage "Error: $1 requires an argument"
    fi
    echo "$2"
}

typeset -A var
var[-s]="$HOME/Pictures/by-date"
var[-e]='arw'
var[-w]="$PWD/files.hash"
run_hash=true

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage ;;
    -f) run_hash=false ;;
    -e | -s | -w)
        # Append '|| exit 1' to exit on first bad arg.
        var["$1"]=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        usage "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

EXT="${var[-e]}"
SYM="${var[-s]}"
FILE="${var[-w]}"

if ((!$#)) && $run_hash; then
    usage "Error: source_directory required"
elif $run_hash; then
    SEARCH_DIR="$1"
elif (($#)) && ! $run_hash; then
    FILE="$1"
elif ((!$#)) && ! $run_hash; then
    usage "Error: hash file required"
fi

if $run_hash; then
    files=$(fd "$SEARCH_DIR" -a -tf -e "$EXT" -X du -b)
    [[ $files == "" ]] && echo "No files found" && exit 0
    sz=$(awk '{sum+=$1} 
END {
    if (sum >= 1024*1024*1024) printf "%.1f GiB\n", sum/1024/1024/1024
    else if (sum >= 1024*1024)   printf "%.1f MiB\n", sum/1024/1024
    else if (sum >= 1024)        printf "%.1f KiB\n", sum/1024
    else                         printf "%d Bi\n", sum
  }' <<<"$files")

    Q "Find duplicate ${EXT^^} [$(echo "$files" | wc -l) files ($sz)] ?"
    echo "$files" | cut -f2- | rapidhash -j 40 -s -p >"$FILE"
    echo "File hashes written to $FILE"
fi

awk -F'\t' -v prefer="$SYM" \
    -f "$(dirname "$(realpath "$0")")/process-dupes.awk" "$FILE"
