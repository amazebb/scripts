#!/usr/bin/env bash
# Backup photos from camera and organize into date folders

# shellcheck disable=SC2016

U() {
    tput smul
    printf '%s' "$*"
    tput rmul
}

B() {
    tput bold
    printf '%s' "$*"
    tput sgr0
}

I() {
    tput sitm
    printf '%s' "$*"
    tput ritm
}

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

info() { printf "\033[31m%s\033[0m\n" "$1" >&2; }

warn() { info "$1" && exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
    # NOTE Because 'warn' is called in a sub-shell, the exit 1 does not
    # exit immediately. The parse arguments while loop will cycle
    # through all entered args.
}

noargs() { ((!$1)) && info "Error: no arguments provided" && usage && exit 1; }

usage() {
    cat <<EOF
$(B NAME)
    $(B rawsync) - Backup photos from camera and organize into date folders

$(B SYNOPSIS)
    $(B "rawsync [-h] [-c] [-d | -e | -s | -f]") $(U source_directory) [$(U target_directory)]
 
$(B DESCRIPTION)
    Use $(B rsync) to copy files from the $(U source_directory) to a backup destination $(U target_directory).
    Additionally a 'by-date' folder is created with symlinks to the backups to make 
    browsing for files by date easier.
    If only the $(U source_directory) is given then only symlinks are created.
    The $(B exiftool) is used to extract date information from the files to create the symlinks.

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -c)        Count symlinks and files in date folders and exit

    $(B -e) $(U ext)    Extensions to process $(I '(default: *.ARW)')

    $(B -d) $(U date)   Create symlinks for files modified after $(U date) $(I '(default: 1970-01-01)')

    $(B -s) $(U sym)    Root folder location for symlinks ($(I 'default: by-date'))

    $(B -f) $(U fmt)    Sub-folder date naming format for symlinks $(I '(default: %Y/%Y%m%d)')
 
$(B EXAMPLES)
    Backup all files from attached camera volume SD1 to an external SSD

        rawsync "/Volumes/SD1/DCIM" "/Volumes/PHOTOS/RAW"

    Create symlinks only from the RAW folder and place into /Volumes/PHOTOS/by-date/

        rawsync "/Volumes/PHOTOS/RAW"

    Create symlinks for files taken after 2025-12-01

        rawsync -d 2025-12-01 "/Volumes/SD1/DCIM" "/Volumes/PHOTOS/RAW"

    Create symlinks only for CR3 raw files

        rawsync -e '*.CR3' "/Volumes/PHOTOS/RAW"

    Count symlinks and files in date folders

        rawsync -c "/Volumes/PHOTOS/by-date"

EOF
}

count_summary() {
    for y in $(seq 1999 "$(date +%Y)"); do
        [ -d "$1/$y" ] || continue
        Y=${y##*/}
        for m in {01..12}; do
            num=$(find "$1/$y/$Y${m}"* \( -type l -o -type f \) 2>/dev/null | wc -l)
            ((num)) && echo "$y/$Y${m}: $num"
        done
    done
}

noargs $#

declare -A var
var[-s]="by-date"
var[-d]="1970-01-01"
var[-f]="%Y/%Y%m%d"
var[-e]='*.ARW'

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -c) COUNT=1 ;;
    -d | -e | -f | -s)
        var["$1"]=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

DATE="${var[-d]}"
EXT="${var[-e]}"
DATE_FMT="${var[-f]}"
SYM="${var[-s]}"

if ((!$#)); then
    warn "Error: source_directory required"
fi

SRC_DIR="$1"
shift

if ((COUNT)); then
    count_summary "$SRC_DIR"
    exit 0
fi

if (($#)); then
    command -v rsync >/dev/null || warn "rsync not found"

    TARGET="$1"
    shift
    TARGET_ROOT=$(echo "$TARGET" | cut -d'/' -f1-3)

    list=$(rsync -nia "$SRC_DIR" "$TARGET" 2>&1) || warn "$list"
    num_copy=$(echo "$list" | grep -c '^>f+')
    num_meta=$(echo "$list" | grep -c '^\.d')

    Q "Backup from $SRC_DIR to $TARGET: ($num_copy copies, $num_meta folder meta changes)"
    rsync -avhP "$SRC_DIR" "$TARGET" 2>"$TARGET_ROOT/rsync_$(date +%Y%m%dT%H%M%S).log"
else
    TARGET_ROOT=$(echo "$SRC_DIR" | cut -d'/' -f1-3)
fi

num=$(find "$SRC_DIR" -type f -iname "$EXT" -newermt "$DATE" 2>/dev/null | wc -l)
((!num)) && warn "No files found in $SRC_DIR"

command -v grealpath >/dev/null || warn "GNU coreutils grealpath is needed 'brew install coreutils'"
command -v exiftool >/dev/null || warn "exiftool not found"
Q "Create $num symlinks in $TARGET_ROOT/$SYM from $SRC_DIR"

failed=0
while IFS='|' read -r src date; do
    target_dir="$TARGET_ROOT/$SYM/$date"
    mkdir -p "$target_dir"
    src_file=$(grealpath --relative-to="$target_dir" "$src")
    if ! ln -sf "$src_file" "$target_dir/"; then
        ((failed++))
    fi
done < <(
    find "$SRC_DIR" -type f -iname "$EXT" -newermt "$DATE" -print0 |
        xargs -0 exiftool -fast2 \
            -printFormat '$Directory/$FileName|$DateTimeOriginal' \
            -dateFormat "$DATE_FMT"
)

((failed)) && info "$failed symlinks failed to create"
