#!/usr/bin/env bash
# RAW image backups and organizer

# shellcheck disable=SC2016
# shellcheck source=common.sh
source "$(dirname "$0")/common.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B rawsync) - RAW image backups and organizer

$(B SYNOPSIS)
    $(B "rawsync [-h] [-c] [-d date] [-e ext] [-f day|month|fmt] [-s path]") $(U source_directory) [$(U target_directory)]

$(B DESCRIPTION)
    Use $(B rsync) to copy files from the $(U source_directory) to a backup destination $(U target_directory).
    Additionally a $(I raw-by-day) (or $(I raw-by-month)) folder is created with symlinks to the
    backups to make browsing for files by date easier. By default this folder is placed
    inside the RAW folder (the $(U target_directory), or the $(U source_directory) if no target
    is given); use $(B -s) to override that location.
    If only the $(U source_directory) is given then only symlinks are created.
    The $(B exiftool) is used to extract date information from the files to create the symlinks.
    Symlinks are named $(I yyyymmdd_HHMMSS-TZ.ext) (e.g. $(I 20260101_163523-0700.ARW)) using the
    EXIF timezone offset, with a fallback to the file modification date timezone when it
    matches DateTimeOriginal to the second.

$(B OPTIONS)
    $(B -h)        Show this help message

    $(B -c)        Count symlinks and files in date folders and exit

    $(B -e) $(U ext)    Extensions to process $(I '(default: *.ARW)')

    $(B -d) $(U date)   Create symlinks for files modified after $(U date) $(I '(default: 1970-01-01)')

    $(B -f) $(U fmt)    Date grouping for symlinks: $(B day) creates $(I raw-by-day/%Y/%Y%m%d),
              $(B month) creates $(I raw-by-month/%Y/%Y%m), or pass any $(B gdate) format
              string (e.g. $(I %Y/%Y%m)) to use it directly — the parent folder is
              named $(I raw-by-)$(U fmt) with % stripped and / replaced by _
              $(I '(default: day)')

    $(B -s) $(U path)   Parent folder for the $(I raw-by-day)/$(I raw-by-month) folder
              $(I '(default: inside the RAW folder)')

$(B EXAMPLES)
    Backup all files from attached camera volume SD1 to an external SSD,
    creating symlinks in /Volumes/PHOTOS/RAW/raw-by-day/

        rawsync "/Volumes/SD1/DCIM" "/Volumes/PHOTOS/RAW"

    Create only symlinks in /Volumes/PHOTOS/RAW/raw-by-day/ from the RAW folder

        rawsync "/Volumes/PHOTOS/RAW"

    Create only symlinks in /Volumes/PHOTOS/RAW/raw-by-month/ grouped by month

        rawsync -f month "/Volumes/PHOTOS/RAW"

    Place the $(I raw-by-day) folder at the volume root instead of inside the RAW folder

        rawsync -s /Volumes/PHOTOS "/Volumes/PHOTOS/RAW"

    Create only symlinks for files taken after 2025-12-01

        rawsync -d 2025-12-01 "/Volumes/SD1/DCIM" "/Volumes/PHOTOS/RAW"

    Create only symlinks for CR3 raw files

        rawsync -e '*.CR3' "/Volumes/PHOTOS/RAW"

    Count symlinks and files in date folders

        rawsync -c "/Volumes/PHOTOS/RAW/raw-by-day"

EOF
}

count_summary() {
    for y in $(seq 1999 "$(date +%Y)"); do
        [ -d "$1/$y" ] || continue
        Y=${y##*/}
        for m in {01..12}; do
            num=$(find "$1/$y/$Y${m}"* \( -type l -o -type f \) 2>/dev/null | wc -l)
            ((num)) && echo "$y/$Y${m}: $num"
        done
    done
}

noargs $#

declare -A var
var[-d]="1970-01-01"
var[-f]="day"
var[-e]='*.ARW'

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage && exit 0 ;;
    -c) COUNT=1 ;;
    -d | -e | -f | -s)
        var["$1"]=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        warn "Unknown option: $1"
        ;;
    *) break ;; # Positional arguments
    esac
    shift
done

DATE="${var[-d]}"
EXT="${var[-e]}"

case "${var[-f]}" in
day) SYM="raw-by-day" DATE_FMT="%Y/%Y%m%d" ;;
month) SYM="raw-by-month" DATE_FMT="%Y/%Y%m" ;;
*)
    DATE_FMT="${var[-f]}"
    fmt="${DATE_FMT//%/}"
    fmt="${fmt//\//_}"
    SYM="raw-by-$fmt"
    ;;
esac

if ((!$#)); then
    warn "Error: source_directory required"
fi

SRC_DIR="$1"
shift

if ((COUNT)); then
    count_summary "$SRC_DIR"
    exit 0
fi

if (($#)); then
    command -v rsync >/dev/null || warn "rsync not found"

    TARGET="$1"
    shift
    TARGET_ROOT=$(echo "$TARGET" | cut -d'/' -f1-3)
    SYM_ROOT="${var[-s]:-$TARGET}"

    list=$(rsync -nia "$SRC_DIR" "$TARGET" 2>&1) || warn "$list"
    num_copy=$(echo "$list" | grep -c '^>f+')
    num_meta=$(echo "$list" | grep -c '^\.d')

    Q "Backup from $SRC_DIR to $TARGET: ($num_copy copies, $num_meta folder meta changes)"
    rsync -avhP "$SRC_DIR" "$TARGET" 2>"$TARGET_ROOT/rsync_$(date +%Y%m%dT%H%M%S).log"
else
    SYM_ROOT="${var[-s]:-$SRC_DIR}"
fi

num=$(find "$SRC_DIR" -type f -iname "$EXT" -newermt "$DATE" 2>/dev/null | wc -l)
((!num)) && warn "No files found in $SRC_DIR"

command -v grealpath >/dev/null || warn "GNU coreutils grealpath is needed 'brew install coreutils'"
command -v gdate >/dev/null || warn "GNU coreutils gdate is needed 'brew install coreutils'"
command -v exiftool >/dev/null || warn "exiftool not found"
Q "Create $num symlinks in $SYM_ROOT/$SYM from $SRC_DIR"

failed=0
count=0
start=$SECONDS
last_update=$SECONDS
while IFS='|' read -r src dto oto ot fmd; do
    [[ -z "$dto" ]] && continue
    ((count++))

    # Progress update every second
    now=$SECONDS
    if ((now > last_update)); then
        elapsed=$((now - start))
        eta=$(((num - count) * elapsed / count))
        printf "\r\033[K%d/%d symlinks (%ds elapsed, ~%ds remaining)" "$count" "$num" "$elapsed" "$eta" >&2
        last_update=$now
    fi

    # Determine timezone: OffsetTimeOriginal > OffsetTime > FileModifyDate fallback
    tz=""
    for offset in "$oto" "$ot"; do
        offset="${offset#"${offset%%[![:space:]]*}"}"
        if [[ -n "$offset" ]]; then
            tz="${offset//:/}"
            break
        fi
    done
    if [[ -z "$tz" && -n "$fmd" ]]; then
        fmd_dt="${fmd:0:19}"
        if [[ "$fmd_dt" == "$dto" ]]; then
            tz="${fmd:19}"
            tz="${tz//:/}"
        fi
    fi

    # Format symlink name: yyyymmdd_HHMMSS-TZ.ext
    dt="${dto//:/}"
    dt="${dt// /_}"
    ext="${src##*.}"
    base="${dt}${tz}"

    # Format subfolder using DATE_FMT (convert EXIF "YYYY:MM:DD" to "YYYY-MM-DD")
    subfolder=$(gdate -d "${dto:0:4}-${dto:5:2}-${dto:8}" "+$DATE_FMT" 2>/dev/null)
    [[ -z "$subfolder" ]] && continue

    target_dir="$SYM_ROOT/$SYM/$subfolder"
    mkdir -p "$target_dir"

    # Deduplicate: append _N suffix if symlink already exists
    sym_name="${base}.${ext}"
    n=1
    while [[ -e "$target_dir/$sym_name" ]]; do
        sym_name="${base}_${n}.${ext}"
        ((n++))
    done

    src_file=$(grealpath --relative-to="$target_dir" "$src")
    if ! ln -sf "$src_file" "$target_dir/$sym_name"; then
        ((failed++))
    fi
done < <(
    find "$SRC_DIR" -type f -iname "$EXT" -newermt "$DATE" -print0 |
        xargs -0 exiftool -fast2 \
            -printFormat '$Directory/$FileName|$DateTimeOriginal|$OffsetTimeOriginal|$OffsetTime|$FileModifyDate'
)

printf "\r\033[K%d/%d symlinks done in %ds\n" "$count" "$num" "$((SECONDS - start))" >&2
((failed)) && info "$failed symlinks failed to create"
