#!/usr/bin/env bash

usage() {
    cat <<EOF
$(_b NAME)
    $(_b rawsync) - Backup photos from camera

$(_b SYNOPSIS)
    $(_b "rawsync [-h] [-d | -s]") $(_u source_directory) $(_u target_directory)
 
$(_b DESCRIPTION)
    Copy files from the $(_u source_directory) to a backup destination $(_u target_directory)
    The $(_b rsync) utility is used to do the copy and $(_b exiftool) to extract date 
    information to create the symlinked folder structure.

$(_b OPTIONS)
    -h        Show this help message
    -d $(_u date)   Run exiftool on files modified after $(_u date)
    -s        Create symlinks
 
$(_b EXAMPLES)
    Backup all files from attached camera to external SSD

        rawsync "/Volumes/SD1/DCIM" "/Volumes/PHOTOS-01-T7/SD Card"

EOF
    exit 0
}

_u() {
    printf "%s" "$(tput smul)$1$(tput rmul)"
}

_b() {
    printf "%s" "$(tput bold)$1$(tput sgr0)"
}

((!$#)) && usage

SRC="/Volumes/PHOTOS-01-T7/SD Card/DCIM/100MSDCF"
TARGET="/Volumes/PHOTOS-01-T7"
DATE="1900-01-01"
NUM_PROC="1" #$(sysctl -n hw.ncpu)"

# Parse arguments
while (($#)); do
    case $1 in
    -h) usage ;;
    -d)
        if (($# < 2)); then
            echo "Error: -d|--date requires an argument" >&2
            usage
        fi
        DATE="$2"
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        echo "Unknown option: $1" >&2
        usage
        ;;
    *) break ;; # Non-option args (positionals)
    esac
    shift
done

SD_CARD="$1"
shift
BACKUP="$1"
shift
SRC="$1"
shift
TARGET="$1"
shift

# Copy photos from camera internal SD card to external SSD

# rsync -avhP "$SD_CARD" "$BACKUP" 2>"/Volumes/PHOTOS-01-T7/rsync_$(date +%Y%m%dT%H%M%S).log"

# shellcheck disable=SC2016
find "$SRC" -type f -newermt "$DATE" -print0 |
    xargs -0 -P"$NUM_PROC" exiftool -fast2 \
        -printFormat '$Directory/$FileName|$DateTimeOriginal' \
        -dateFormat '%Y/%Y-%m/%d' |
    while IFS='|' read -r src date; do
        [ -z "$date" ] && continue
        target_dir="$TARGET/$date"
        mkdir -p "$target_dir"
        src_file=$(realpath --relative-to="$target_dir" "$src")
        ln -sf "$src_file" "$target_dir/" 2>/dev/null
    done
