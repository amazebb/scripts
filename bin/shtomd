#!/usr/bin/env bash
# Convert a script's usage() heredoc to markdown
# shellcheck disable=SC2016

U() {
    tput smul
    printf '%s' "$*"
    tput rmul
}

B() {
    tput bold
    printf '%s' "$*"
    tput sgr0
}

I() {
    tput sitm
    printf '%s' "$*"
    tput ritm
}

Q() {
    read -r -p "$1 [y/n]: "
    [[ ! $REPLY =~ [Yy] ]] && echo "Aborted." && exit 1
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

msg() { printf "\033[%sm%s\033[0m\n" "$2" "$1" >&2; }

info() { msg "$1" 34; }

warn() { msg "$1" 31 && exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
}

noargs() { ((!$1)) && info "Error: no arguments provided" && usage && exit 1; }

usage() {
    cat <<EOF
$(B NAME)
    $(B shtomd) - Convert a script's usage() heredoc to markdown

$(B SYNOPSIS)
    $(B "shtomd [-h]") $(U script)

$(B DESCRIPTION)
    Reads $(U script), locates the heredoc body inside its $(B usage)$(I \(\))
    function, and emits it wrapped in an HTML $(I '<pre>') block so that the
    original indentation is preserved while still allowing inline formatting
    to render in markdown viewers.

    The tput-helper calls are rewritten inline: $(I '\$(B x)') becomes
    $(I '<b>x</b>'), $(I '\$(U x)') becomes $(I '<u>x</u>'), and
    $(I '\$(I x)') becomes $(I '<i>x</i>'). Surrounding single or double
    quotes around the argument are stripped.

$(B OPTIONS)
    $(B -h)        Show this help message

$(B EXAMPLES)
    Print the usage of a script as markdown

        shtomd bin/exifmv

    Write the usage to a file

        shtomd bin/exifmv > exifmv.md

EOF
}

noargs $#

while (($#)); do
    case "$1" in
    -h) usage && exit 0 ;;
    --)
        shift
        break
        ;;
    -*) warn "Unknown option: $1" ;;
    *) break ;;
    esac
    shift
done

SCRIPT="${1:-}"
[[ -z "$SCRIPT" ]] && warn "Error: script path is required"
[[ ! -f "$SCRIPT" ]] && warn "Error: '$SCRIPT' is not a file"

body=$(awk '
    /^    cat <<EOF$/ && !in_body { in_body=1; next }
    in_body && /^EOF$/ { exit }
    in_body { print }
' "$SCRIPT")

[[ -z "$body" ]] && warn "Error: no usage() heredoc found in '$SCRIPT'"

md=$(printf '%s\n' "$body" | sed -E '
    s/\$\(B "([^"]+)"\)/<b>\1<\/b>/g
    s/\$\(B '\''([^'\'']+)'\''\)/<b>\1<\/b>/g
    s/\$\(B ([^)]+)\)/<b>\1<\/b>/g
    s/\$\(U "([^"]+)"\)/<u>\1<\/u>/g
    s/\$\(U '\''([^'\'']+)'\''\)/<u>\1<\/u>/g
    s/\$\(U ([^)]+)\)/<u>\1<\/u>/g
    s/\$\(I "([^"]+)"\)/<i>\1<\/i>/g
    s/\$\(I '\''([^'\'']+)'\''\)/<i>\1<\/i>/g
    s/\$\(I ([^)]+)\)/<i>\1<\/i>/g
')

printf '<pre>\n%s\n</pre>\n' "$md"
