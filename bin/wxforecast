#!/usr/bin/env bash
# Print the NWS hourly or daily weather forecast for a US location

# shellcheck disable=SC2016
source "$(dirname "$0")/common.sh"
# shellcheck source=wx/wxgeo.sh
source "$(dirname "$0")/wx/wxgeo.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B wxforecast) - Print the hourly or daily weather forecast for a US location

$(B SYNOPSIS)
    $(B "wxforecast [-h] [-A] [-d] [-r] [-y metric [metric2]] [-u units] [-n count]") [$(U location)]

$(B DESCRIPTION)
    Draws a chart of the National Weather Service hourly forecast (free, no key), with
    time along the x axis, the y metric as a dot per hour and a weather emoji for each
    hour under the axis. The chart shows as many hours as fit the terminal width.
    With $(B -r) it prints one raw line per hour instead, with the temperature, feels-like,
    dew point, humidity, cloud cover, chance of rain, expected rainfall, wind gust, wind and
    conditions. Snowfall and visibility are chart-only metrics. With $(B -d) it shows the daily forecast
    instead: a chart of the high and low with the chance of rain, or with $(B -r) one line per day
    with the high, low, chance of rain, wind and conditions.
    With no $(U location) your IP address is used. US only.

$(B OPTIONS)
    $(B -h)           Show this help message

    $(B -A)           Do not show active weather alerts at the top. By default one line per
                  alert is printed first, from $(B wxalerts)

    $(B -d)           Print the daily forecast as a chart of the high and low temperature with
                  the chance of rain on a right hand axis, or one line per day with $(B -r).
                  $(B -y) does not apply

    $(B -r)           Print raw rows, one line per hour, instead of the chart

    $(B -y) $(U metric) [$(U metric2)]  Value for the chart y axis $(I '(default: temp qpf)'). A second metric
                  goes on a right hand axis with its own scale, drawn as orange $(I ◆)
                  markers and labels. Wind and gust use an arrow pointing the way the wind blows

                  $(I temp)    temperature          $(I rain)   chance of rain
                  $(I feels)   feels-like           $(I qpf)    expected rainfall
                  $(I dew)     dew point            $(I snow)   expected snowfall
                  $(I hum)     relative humidity    $(I wind)   wind speed
                  $(I cloud)   cloud cover          $(I gust)   wind gust
                                                $(I vis)    visibility

    $(B -u) $(U units)    $(I imperial) (°F, mph, in) or $(I si) (°C, km/h, mm) $(I '(default: imperial)')

    $(B -n) $(U count)    Number of hours to show, 1 to 156, or days with $(B -d), 1 to 7
                  $(I '(default: 24 hours, 7 days)')

    [$(U location)]    One of the following $(I '(default: your IP location)')

                  $(I 10001)               zip code
                  $(I 40.71,-74.0)         latitude,longitude

$(B EXAMPLES)
    Temperature and expected rainfall chart with weather emoji for where you are

        wxforecast

    Expected rainfall chart for a zip code

        wxforecast -y qpf 60601

    Relative humidity chart

        wxforecast -y hum

    The week ahead

        wxforecast -d

    Temperature only

        wxforecast -y temp

    Temperature with wind direction arrows

        wxforecast -y temp wind

    Raw rows for the next 48 hours

        wxforecast -r -n 48 60601

EOF
}

# grid_hours: read NWS grid data json, print "name UTC-hour value" for every hour of each block, in SI units.
# Rainfall and snow are block totals (mm over the validTime period), spread evenly over its hours;
# the rest are instantaneous values repeated over the block.
grid_hours() {
    awk -f "$AWKDIR/wx-time.awk" -f "$AWKDIR/wxforecast-grid.awk"
}

# place_of POINTS: "City, ST" from an api.weather.gov/points response
place_of() { awk -F'"' '/"city": "[A-Z]/ { c = $4 } /"state": "[A-Z]/ { print c ", " $4; exit }' <<<"$1"; }

# stamps_of JSON: ", updated DD-MMM-YYYY HH:MM, generated ..." from a forecast response
stamps_of() {
    local k t stamps=''
    for k in updateTime:updated generatedAt:generated; do
        t=$(sed -n "s/.*\"${k%:*}\": *\"\([^\"]*\)\".*/\1/p" <<<"$1" | head -1)
        [[ -n $t ]] && stamps+=", ${k#*:} $(stamp_fmt "$(iso_epoch "$t")")"
    done
    echo "$stamps"
}

# forecast_for LAT LON HOURS METRIC GRAPH UNITS METRIC2: print HOURS of the NWS hourly forecast as a METRIC chart,
# or as raw rows when GRAPH is 0
forecast_for() {
    local pt url grid place cols g hourly
    pt=$(curl -fsSL -A "$UA" "https://api.weather.gov/points/$1,$2") || warn "No NWS forecast for $1,$2 (US only)"
    url=$(sed -n 's/.*"forecastHourly": *"\(.*\)".*/\1/p' <<<"$pt")
    grid=$(sed -n 's/.*"forecastGridData": *"\(.*\)".*/\1/p' <<<"$pt")
    g=$(curl -fsSL -A "$UA" "$grid" | grid_hours) || info "No grid data (rainfall, gusts, cloud cover) available"
    place=$(place_of "$pt")
    cols=$(tput cols 2>/dev/null || echo 80)
    hourly=$(curl -fsSL -A "$UA" "$url") || warn "Could not fetch the hourly forecast"
    info "${place:-$1,$2} hourly forecast (NWS)$(stamps_of "$hourly")"
    awk -v hours="$3" -v metric="$4" -v graph="$5" -v metric2="$7" -v cols="$cols" -v si="$([[ $6 == si ]] && echo 1 || echo 0)" -f "$AWKDIR/wx-time.awk" -f "$AWKDIR/wx-emoji.awk" -f "$AWKDIR/wxforecast-hourly.awk" <(printf '%s\n' "$g") - <<<"$hourly"
}

# daily_for LAT LON DAYS UNITS GRAPH: print the NWS 12 hour forecast periods as a high and low chart,
# or one row per day when GRAPH is 0
daily_for() {
    local pt url place daily
    pt=$(curl -fsSL -A "$UA" "https://api.weather.gov/points/$1,$2") || warn "No NWS forecast for $1,$2 (US only)"
    url=$(sed -n 's/.*"forecast": *"\(.*\)".*/\1/p' <<<"$pt")
    place=$(place_of "$pt")
    daily=$(curl -fsSL -A "$UA" "$url") || warn "Could not fetch the daily forecast"
    info "${place:-$1,$2} daily forecast (NWS)$(stamps_of "$daily")"
    awk -v ndays="$3" -v graph="$5" -v si="$([[ $4 == si ]] && echo 1 || echo 0)" -f "$AWKDIR/wx-time.awk" -f "$AWKDIR/wx-emoji.awk" -f "$AWKDIR/wxforecast-daily.awk" <<<"$daily"
}

main() {
    local hours="" alerts=1 daily=0 graph=1 metric=temp metric2=qpf units=imperial loc ll
    while (($#)); do
        case $1 in
        -h)
            usage
            exit 0
            ;;
        -A) alerts=0 ;;
        -d) daily=1 ;;
        -r) graph=0 ;;
        -y)
            metric=$(argval "$@")
            metric2=""
            shift
            if is_metric "${2-}"; then
                metric2=$2
                shift
            fi
            ;;
        -u)
            units=$(argval "$@" | tr "[:upper:]" "[:lower:]")
            shift
            ;;
        -n)
            hours=$(argval "$@")
            shift
            ;;
        --)
            shift
            break
            ;;
        -*) warn "Unknown option: $1" ;;
        *) break ;;
        esac
        shift
    done
    (($# <= 1)) || warn "Unexpected argument: $2"
    loc=${1-}
    if ((daily)); then
        hours=${hours:-7}
        [[ $hours =~ ^[0-9]+$ ]] || warn "Days must be a number"
        ((hours >= 1 && hours <= 7)) || warn "Days must be 1 to 7"
    else
        hours=${hours:-24}
        [[ $hours =~ ^[0-9]+$ ]] || warn "Hours must be a number"
        ((hours >= 1 && hours <= 156)) || warn "Hours must be 1 to 156"
    fi
    [[ $units == @(imperial|si) ]] || warn "Units must be imperial or si"
    is_metric "$metric" || warn "Metric must be ${METRICS//|/, }"

    command -v curl &>/dev/null || warn "curl not found"
    ll=$(latlon "$loc") || warn "Forecast needs a zip code or latitude,longitude"
    ((alerts)) && "$(dirname "$0")/wxalerts" -b "${ll// /,}" >&2
    if ((daily)); then
        # shellcheck disable=SC2086
        daily_for $ll "$hours" "$units" "$graph"
    else
        # shellcheck disable=SC2086
        forecast_for $ll "$hours" "$metric" "$graph" "$units" "$metric2"
    fi
}

main "$@"
