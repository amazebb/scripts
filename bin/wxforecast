#!/usr/bin/env bash
# Print the NWS hourly weather forecast for a US location as text

# shellcheck disable=SC2016
source "$(dirname "$0")/common.sh"
source "$(dirname "$0")/wxgeo.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B wxforecast) - Print the hourly weather forecast for a US location

$(B SYNOPSIS)
    $(B "wxforecast [-h] [-r] [-y metric [metric2]] [-u units] [-n hours]") [$(U location)]

$(B DESCRIPTION)
    Draws a chart of the National Weather Service hourly forecast (free, no key), with
    time along the x axis, the y metric as a dot per hour and a weather emoji for each
    hour under the axis. The chart shows as many hours as fit the terminal width.
    With $(B -r) it prints one raw line per hour instead, with the temperature, feels-like,
    dew point, humidity, cloud cover, chance of rain, expected rainfall, wind gust, wind and
    conditions. Snowfall and visibility are chart-only metrics. With no $(U location) your IP
    address is used. US only.

$(B OPTIONS)
    $(B -h)           Show this help message

    $(B -r)           Print raw rows, one line per hour, instead of the chart

    $(B -y) $(U metric) [$(U metric2)]  Value for the chart y axis $(I '(default: temp)'). A second metric
                  goes on a right hand axis with its own scale, drawn as orange $(I ◆)
                  markers and labels. Wind and gust use an arrow pointing the way the wind blows

                  $(I temp)    temperature          $(I rain)   chance of rain
                  $(I feels)   feels-like           $(I qpf)    expected rainfall
                  $(I dew)     dew point            $(I snow)   expected snowfall
                  $(I hum)     relative humidity    $(I wind)   wind speed
                  $(I cloud)   cloud cover          $(I gust)   wind gust
                                                $(I vis)    visibility

    $(B -u) $(U units)    $(I imperial) (°F, mph, in) or $(I si) (°C, km/h, mm) $(I '(default: imperial)')

    $(B -n) $(U hours)    Number of hours to show, 1 to 156 $(I '(default: 24)')

    [$(U location)]    One of the following $(I '(default: your IP location)')

                  $(I 10001)               zip code
                  $(I 40.71,-74.0)         latitude,longitude

$(B EXAMPLES)
    Temperature chart with weather emoji for where you are

        wxforecast

    Expected rainfall chart for a zip code

        wxforecast -y qpf 60601

    Relative humidity chart

        wxforecast -y hum

    Temperature with expected rainfall on a second axis

        wxforecast -y temp qpf

    Temperature with wind direction arrows

        wxforecast -y temp wind

    Raw rows for the next 48 hours

        wxforecast -r -n 48 60601

EOF
}

# awk helpers: epochh(TS) is the UTC hour count of an ISO 8601 timestamp with a whole-hour offset
AWK_TIME='
function days(y, m, d,    era, yoe, doy) {
    if (m <= 2) y--
    era = int(y / 400); yoe = y - era * 400
    doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
    return era * 146097 + yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy - 719468
}
function epochh(ts,    sign) {
    sign = substr(ts, 20, 1) == "-" ? -1 : 1
    return days(substr(ts, 1, 4) + 0, substr(ts, 6, 2) + 0, substr(ts, 9, 2) + 0) * 24 + substr(ts, 12, 2) - sign * substr(ts, 21, 2)
}'

# grid_hours: read NWS grid data json, print "name UTC-hour value" for every hour of each block, in SI units.
# Rainfall and snow are block totals (mm over the validTime period), spread evenly over its hours;
# the rest are instantaneous values repeated over the block.
grid_hours() {
    awk "$AWK_TIME"'
        BEGIN {
            f["quantitativePrecipitation"] = "qpf"; f["snowfallAmount"] = "snow"; f["windGust"] = "gust"
            f["skyCover"] = "cloud"; f["apparentTemperature"] = "feels"; f["visibility"] = "vis"
            total["qpf"] = total["snow"] = 1
        }
        /^        "[A-Za-z]+": *\{/ { split($1, kk, "\""); name = (kk[2] in f) ? f[kk[2]] : "" }
        name != "" && /"validTime"/ {
            split($0, a, "\"")
            split(a[4], v, "/")
            h = 0
            if (match(v[2], /[0-9]+D/)) h += substr(v[2], RSTART, RLENGTH - 1) * 24
            if (match(v[2], /[0-9]+H/)) h += substr(v[2], RSTART, RLENGTH - 1)
            start = epochh(v[1])
        }
        name != "" && /"value"/ && h > 0 {
            x = $0; gsub(/[^0-9.-]/, "", x)
            for (k = 0; k < h; k++) printf "%s %d %.4f\n", name, start + k, total[name] ? x / h : x
            h = 0
        }'
}

# forecast_for LAT LON HOURS METRIC GRAPH UNITS METRIC2: print HOURS of the NWS hourly forecast as a METRIC chart,
# or as raw rows when GRAPH is 0
forecast_for() {
    local pt url grid place cols g hourly stamps='' k t
    pt=$(curl -fsSL -A "$UA" "https://api.weather.gov/points/$1,$2") || warn "No NWS forecast for $1,$2 (US only)"
    url=$(sed -n 's/.*"forecastHourly": *"\(.*\)".*/\1/p' <<<"$pt")
    grid=$(sed -n 's/.*"forecastGridData": *"\(.*\)".*/\1/p' <<<"$pt")
    g=$(curl -fsSL -A "$UA" "$grid" | grid_hours) || info "No grid data (rainfall, gusts, cloud cover) available"
    place=$(awk -F'"' '/"city": "[A-Z]/ { c = $4 } /"state": "[A-Z]/ { print c ", " $4; exit }' <<<"$pt")
    cols=$(tput cols 2>/dev/null || echo 80)
    hourly=$(curl -fsSL -A "$UA" "$url") || warn "Could not fetch the hourly forecast"
    for k in updateTime:updated generatedAt:generated; do
        t=$(sed -n "s/.*\"${k%:*}\": *\"\([^\"]*\)\".*/\1/p" <<<"$hourly" | head -1)
        [[ -n $t ]] && stamps+=", ${k#*:} $(stamp_fmt "$(iso_epoch "$t")")"
    done
    info "${place:-$1,$2} hourly forecast (NWS)$stamps"
    awk -v hours="$3" -v metric="$4" -v graph="$5" -v metric2="$7" -v cols="$cols" -v si="$([[ $6 == si ]] && echo 1 || echo 0)" "$AWK_TIME"'
        FNR == NR { q[$1, $2] = $3; next }
        function val(l) { gsub(/^[^:]*: *"?|"?,? *$/, "", l); return l }
        function emoji(f, day) {
            f = tolower(f)
            if (f ~ /thunder/) return "⛈️"
            if (f ~ /snow|flurries|sleet|ice|freezing/) return "❄️"
            if (f ~ /rain|showers|drizzle/) return "🌧️"
            if (f ~ /fog|haze|smoke/) return "🌫️"
            if (f ~ /mostly cloudy|overcast|^cloudy/) return "☁️"
            if (f ~ /partly/) return day ? "⛅" : "☁️"
            if (f ~ /mostly (clear|sunny)/) return day ? "🌤️" : "🌙"
            return day ? "☀️" : "🌙"
        }
        function mon(m) { return substr("JanFebMarAprMayJunJulAugSepOctNovDec", (m - 1) * 3 + 1, 3) }
        function grid(name, e) { return ((name, e) in q) ? q[name, e] : 0 }
        function cdeg(c) { return si ? c : c * 9 / 5 + 32 }
        function mv(m, i) {
            if (m == "feels") return feels[i]
            if (m == "dew") return dew[i]
            if (m == "hum") return hum[i]
            if (m == "cloud") return cloud[i]
            if (m == "rain") return rain[i]
            if (m == "qpf") return amt[i]
            if (m == "snow") return snow[i]
            if (m == "wind") return wind[i]
            if (m == "gust") return gust[i]
            if (m == "vis") return vis[i]
            return temp[i]
        }
        /"startTime"/ {
            t = val($0); n++; e = epochh(t)
            amt[n] = grid("qpf", e) / (si ? 1 : 25.4)
            snow[n] = grid("snow", e) / (si ? 1 : 25.4)
            gust[n] = grid("gust", e) / (si ? 1 : 1.609344)
            cloud[n] = grid("cloud", e)
            feels[n] = cdeg(grid("feels", e))
            vis[n] = grid("vis", e) / (si ? 1000 : 1609.344)
            hh[n] = substr(t, 12, 2); dd[n] = substr(t, 9, 2) "-" mon(substr(t, 6, 2)); tm[n] = substr(t, 12, 5)
        }
        /"isDaytime"/ { day = val($0) == "true" }
        /"temperature"/ { temp[n] = si ? (val($0) - 32) * 5 / 9 : val($0) }
        /"probabilityOfPrecipitation"/ { sec = "rain" }
        /"dewpoint"/ { sec = "dew" }
        /"relativeHumidity"/ { sec = "hum" }
        /"value"/ && sec != "" {
            v = val($0); if (v == "null") v = 0
            if (sec == "rain") rain[n] = v
            else if (sec == "hum") hum[n] = v
            else dew[n] = cdeg(v)
            sec = ""
        }
        /"windSpeed"/ { wind[n] = val($0) * (si ? 1.609344 : 1); ws[n] = sprintf("%.0f %s", wind[n], si ? "km/h" : "mph") }
        /"windDirection"/ { wd[n] = val($0) }
        /"shortForecast"/ { sky[n] = val($0); em[n] = emoji(val($0), day) }
        function isfrac(m) { return m == "qpf" || m == "snow" || m == "vis" }
        function iswind(m) { return m == "wind" || m == "gust" }
        function ttl(m,    u) {
            u = si ? "C" : "F"
            if (m == "rain") return "Chance of rain (%)"
            if (m == "hum") return "Relative humidity (%)"
            if (m == "cloud") return "Cloud cover (%)"
            if (m == "dew") return "Dew point (°" u ")"
            if (m == "feels") return "Feels like (°" u ")"
            if (m == "qpf") return "Expected rainfall (" (si ? "mm" : "in") "/hr)"
            if (m == "snow") return "Expected snowfall (" (si ? "mm" : "in") "/hr)"
            if (m == "wind") return "Wind speed (" (si ? "km/h" : "mph") ")"
            if (m == "gust") return "Wind gust (" (si ? "km/h" : "mph") ")"
            if (m == "vis") return "Visibility (" (si ? "km" : "mi") ")"
            return "Temperature (°" u ")"
        }
        # setup(AXIS, COUNT): fill ya[], lo[] and hi[] for the metric on AXIS
        function setup(a, cnt,    i, l, h, mn, m) {
            m = met[a]
            for (i = 1; i <= cnt; i++) ya[a, i] = mv(m, i)
            l = h = ya[a, 1]
            for (i = 1; i <= cnt; i++) { if (ya[a, i] < l) l = ya[a, i]; if (ya[a, i] > h) h = ya[a, i] }
            if (m == "rain" || m == "hum" || m == "cloud") { l = 0; h = 100 }
            if (isfrac(m)) {
                l = 0; mn = m == "qpf" ? (si ? 2 : 0.1) : m == "snow" ? (si ? 25 : 1) : (si ? 10 : 6)
                if (h < mn) h = mn
            } else if (h - l < H - 1) h = l + H - 1
            lo[a] = l; hi[a] = h
        }
        function row(a, i) { return int((ya[a, i] - lo[a]) / (hi[a] - lo[a]) * (H - 1) + 0.5) }
        function lab(a, v,    m) {
            m = met[a]
            return m == "qpf" ? sprintf(si ? "%.1f" : "%.2f", v) : isfrac(m) ? sprintf("%.1f", v) : sprintf("%d", v + 0.5)
        }
        # arrow(I): arrow pointing where the wind blows, from the 16 point direction wd[I]
        function arrow(i,    k, names, ar, idx) {
            split("N NNE NE ENE E ESE SE SSE S SSW SW WSW W WNW NW NNW", names, " ")
            split("↑ ↗ → ↘ ↓ ↙ ← ↖", ar, " ")
            for (k = 1; k <= 16; k++) if (names[k] == wd[i]) idx = k - 1
            return ar[int(((idx * 22.5 + 180) % 360) / 45 + 0.5) % 8 + 1]
        }
        function mark(a, i) { return iswind(met[a]) ? arrow(i) : (a == 1 ? "●" : "◆") }
        function legend(a) { return iswind(met[a]) ? "↗" : (a == 1 ? "●" : "◆") }
        END {
            u = si ? "C" : "F"
            if (!graph) {
                printf "%-12s %5s %5s %5s %4s %4s %4s %8s %4s  %-11s %s\n", "TIME", "TEMP", "FEEL", "DEW", "HUM", "CLD", "RAIN", si ? "AMT(mm)" : "AMT(in)", "GUST", "WIND", "SKY"
                for (i = 1; i <= n && i <= hours; i++)
                    printf "%-12s %3.0f°%s %3.0f°%s %3.0f°%s %3s%% %3.0f%% %3s%% %8s %4.0f  %-11s %s\n", dd[i] " " tm[i], temp[i], u, feels[i], u, dew[i], u, hum[i], cloud[i], rain[i], sprintf(si ? "%.1f" : "%.2f", amt[i]), gust[i], ws[i] " " wd[i], sky[i]
                exit
            }
            sec = metric2 != ""
            w = int((cols - 6) / 3); if (w < 1) w = 1
            m = hours < w ? hours : w; if (m > n) m = n
            H = 10
            met[1] = metric; met[2] = metric2
            setup(1, m); if (sec) setup(2, m)
            orange = "\033[38;5;208m"; reset = "\033[0m"
            if (sec) printf "%s %s   %s%s %s%s\n", legend(1), ttl(metric), orange, legend(2), ttl(metric2), reset
            else printf "%s\n", ttl(metric)
            for (r = H - 1; r >= 0; r--) {
                line = ""
                for (i = 1; i <= m; i++) {
                    pm = row(1, i) == r ? mark(1, i) : " "
                    sm = sec && row(2, i) == r ? orange mark(2, i) reset : " "
                    line = line " " pm sm
                }
                printf "%4s │%s", lab(1, lo[1] + (hi[1] - lo[1]) * r / (H - 1)), line
                if (sec) printf "│ %s%-4s%s", orange, lab(2, lo[2] + (hi[2] - lo[2]) * r / (H - 1)), reset
                printf "\n"
            }
            axis = ""
            for (i = 1; i <= m; i++) axis = axis "───"
            printf "     └%s%s\n", axis, sec ? "┘" : ""
            printf "      "
            for (i = 1; i <= m; i++) printf "\033[%dG%s", 7 + (i - 1) * 3 + 1, em[i]
            printf "\n       "
            for (i = 1; i <= m; i++) printf "%02d ", hh[i]
            printf "\n"
            for (i = 1; i <= m; i++) if (i == 1 || hh[i] == "00") printf "\033[%dG%s", 7 + (i - 1) * 3 + 1, dd[i]
            printf "\n"
        }' <(printf '%s\n' "$g") - <<<"$hourly"
}

main() {
    local hours=24 graph=1 metric=temp metric2="" units=imperial loc ll
    while (($#)); do
        case $1 in
            -h) usage; exit 0 ;;
            -r) graph=0 ;;
            -y)
                metric=$(argval "$@"); shift
                if is_metric "${2-}"; then metric2=$2; shift; fi
                ;;
            -u) units=$(argval "$@" | tr "[:upper:]" "[:lower:]"); shift ;;
            -n) hours=$(argval "$@"); shift ;;
            --) shift; break ;;
            -*) warn "Unknown option: $1" ;;
            *) break ;;
        esac
        shift
    done
    (($# <= 1)) || warn "Unexpected argument: $2"
    loc=${1-}
    [[ $hours =~ ^[0-9]+$ ]] || warn "Hours must be a number"
    ((hours >= 1 && hours <= 156)) || warn "Hours must be 1 to 156"
    [[ $units == @(imperial|si) ]] || warn "Units must be imperial or si"
    is_metric "$metric" || warn "Metric must be ${METRICS//|/, }"

    command -v curl &>/dev/null || warn "curl not found"
    ll=$(latlon "$loc") || warn "Forecast needs a zip code or latitude,longitude"
    # shellcheck disable=SC2086
    forecast_for $ll "$hours" "$metric" "$graph" "$units" "$metric2"
}

main "$@"
