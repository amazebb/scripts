#!/usr/bin/env bash
# Print the NWS hourly weather forecast for a US location as text

# shellcheck disable=SC2016
source "$(dirname "$0")/common.sh"
source "$(dirname "$0")/wxgeo.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B wxforecast) - Print the hourly weather forecast for a US location

$(B SYNOPSIS)
    $(B "wxforecast [-h] [-r] [-y metric] [-n hours]") [$(U location)]

$(B DESCRIPTION)
    Draws a chart of the National Weather Service hourly forecast (free, no key), with
    time along the x axis, the y metric as a dot per hour and a weather emoji for each
    hour under the axis. The chart shows as many hours as fit the terminal width.
    With $(B -r) it prints one raw line per hour instead, with the temperature, chance of
    rain, wind and conditions. With no $(U location) your IP address is used. US only.

$(B OPTIONS)
    $(B -h)           Show this help message

    $(B -r)           Print raw rows, one line per hour, instead of the chart

    $(B -y) $(U metric)   Value for the chart y axis: $(I temp), $(I rain) or $(I wind) $(I '(default: temp)')

    $(B -n) $(U hours)    Number of hours to show, 1 to 156 $(I '(default: 24)')

    [$(U location)]    One of the following $(I '(default: your IP location)')

                  $(I 10001)               zip code
                  $(I 40.71,-74.0)         latitude,longitude

$(B EXAMPLES)
    Temperature chart with weather emoji for where you are

        wxforecast

    Chance of rain chart for a zip code

        wxforecast -y rain 60601

    Raw rows for the next 48 hours

        wxforecast -r -n 48 60601

EOF
}

# forecast_for LAT LON HOURS METRIC GRAPH: print HOURS of the NWS hourly forecast as a METRIC chart,
# or as raw rows when GRAPH is 0
forecast_for() {
    local pt url place cols
    pt=$(curl -fsSL -A "$UA" "https://api.weather.gov/points/$1,$2") || warn "No NWS forecast for $1,$2 (US only)"
    url=$(sed -n 's/.*"forecastHourly": *"\(.*\)".*/\1/p' <<<"$pt")
    place=$(awk -F'"' '/"city": "[A-Z]/ { c = $4 } /"state": "[A-Z]/ { print c ", " $4; exit }' <<<"$pt")
    cols=$(tput cols 2>/dev/null || echo 80)
    info "${place:-$1,$2} hourly forecast (NWS)"
    curl -fsSL -A "$UA" "$url" | awk -v hours="$3" -v metric="$4" -v graph="$5" -v cols="$cols" '
        function val(l) { gsub(/^[^:]*: *"?|"?,? *$/, "", l); return l }
        function emoji(f, day) {
            f = tolower(f)
            if (f ~ /thunder/) return "⛈️"
            if (f ~ /snow|flurries|sleet|ice|freezing/) return "❄️"
            if (f ~ /rain|showers|drizzle/) return "🌧️"
            if (f ~ /fog|haze|smoke/) return "🌫️"
            if (f ~ /mostly cloudy|overcast|^cloudy/) return "☁️"
            if (f ~ /partly/) return day ? "⛅" : "☁️"
            if (f ~ /mostly (clear|sunny)/) return day ? "🌤️" : "🌙"
            return day ? "☀️" : "🌙"
        }
        /"startTime"/ { t = val($0); n++; hh[n] = substr(t, 12, 2); dd[n] = substr(t, 9, 2) "-" mon(substr(t, 6, 2)); tm[n] = substr(t, 12, 5) }
        /"isDaytime"/ { day = val($0) == "true" }
        /"temperature"/ { temp[n] = val($0) }
        /"probabilityOfPrecipitation"/ { sec = "rain" }
        /"dewpoint"|"relativeHumidity"/ { sec = "" }
        /"value"/ && sec == "rain" { rain[n] = val($0) == "null" ? 0 : val($0); sec = "" }
        /"windSpeed"/ { ws[n] = val($0); wind[n] = val($0) + 0 }
        /"windDirection"/ { wd[n] = val($0) }
        /"shortForecast"/ { sky[n] = val($0); em[n] = emoji(val($0), day) }
        function mon(m) { return substr("JanFebMarAprMayJunJulAugSepOctNovDec", (m - 1) * 3 + 1, 3) }
        END {
            if (!graph) {
                printf "%-12s %5s %5s  %-10s %s\n", "TIME", "TEMP", "RAIN", "WIND", "SKY"
                for (i = 1; i <= n && i <= hours; i++)
                    printf "%-12s %4s° %4s%%  %-10s %s\n", dd[i] " " tm[i], temp[i], rain[i], ws[i] " " wd[i], sky[i]
                exit
            }
            w = int((cols - 6) / 3); if (w < 1) w = 1
            m = hours < w ? hours : w; if (m > n) m = n
            for (i = 1; i <= m; i++) y[i] = metric == "rain" ? rain[i] : metric == "wind" ? wind[i] : temp[i]
            lo = hi = y[1]
            for (i = 1; i <= m; i++) { if (y[i] < lo) lo = y[i]; if (y[i] > hi) hi = y[i] }
            if (metric == "rain") { lo = 0; hi = 100 }
            h = 10
            if (hi - lo < h - 1) hi = lo + h - 1
            unit = metric == "rain" ? "%" : metric == "wind" ? " mph" : "°F"
            title = metric == "rain" ? "Chance of rain" : metric == "wind" ? "Wind speed" : "Temperature"
            printf "%s (%s)\n", title, substr(unit, metric == "wind" ? 2 : 1)
            for (r = h - 1; r >= 0; r--) {
                line = ""
                for (i = 1; i <= m; i++) line = line ((int((y[i] - lo) / (hi - lo) * (h - 1) + 0.5) == r) ? " ● " : "   ")
                printf "%4d │%s\n", lo + (hi - lo) * r / (h - 1) + 0.5, line
            }
            axis = ""
            for (i = 1; i <= m; i++) axis = axis "───"
            printf "     └%s\n", axis
            printf "      "
            for (i = 1; i <= m; i++) printf "\033[%dG%s", 7 + (i - 1) * 3 + 1, em[i]
            printf "\n       "
            for (i = 1; i <= m; i++) printf "%02d ", hh[i]
            printf "\n"
            for (i = 1; i <= m; i++) if (i == 1 || hh[i] == "00") printf "\033[%dG%s", 7 + (i - 1) * 3 + 1, dd[i]
            printf "\n"
        }'
}

main() {
    local hours=24 graph=1 metric=temp loc ll
    while (($#)); do
        case $1 in
            -h) usage; exit 0 ;;
            -r) graph=0 ;;
            -y) metric=$(argval "$@"); shift ;;
            -n) hours=$(argval "$@"); shift ;;
            --) shift; break ;;
            -*) warn "Unknown option: $1" ;;
            *) break ;;
        esac
        shift
    done
    (($# <= 1)) || warn "Unexpected argument: $2"
    loc=${1-}
    [[ $hours =~ ^[0-9]+$ ]] || warn "Hours must be a number"
    ((hours >= 1 && hours <= 156)) || warn "Hours must be 1 to 156"
    [[ $metric == @(temp|rain|wind) ]] || warn "Metric must be temp, rain or wind"

    command -v curl &>/dev/null || warn "curl not found"
    ll=$(latlon "$loc") || warn "Forecast needs a zip code or latitude,longitude"
    # shellcheck disable=SC2086
    forecast_for $ll "$hours" "$metric" "$graph"
}

main "$@"
