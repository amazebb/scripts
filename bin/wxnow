#!/usr/bin/env bash
# Show the current weather observed at the nearest NWS station for a US location

# shellcheck disable=SC2016
source "$(dirname "$0")/common.sh"
source "$(dirname "$0")/wxgeo.sh"

usage() {
    cat <<EOF
$(B NAME)
    $(B wxnow) - Show the current weather observed at the nearest station

$(B SYNOPSIS)
    $(B "wxnow [-h] [-u units]") [$(U location)]

$(B DESCRIPTION)
    Prints what the nearest National Weather Service observation station is measuring
    now: temperature, feels-like, dew point, humidity, wind, pressure, visibility and
    recent rainfall, with the station name and when it was observed. These are
    measurements, not a forecast. Stations that report nothing are skipped and the next
    nearest is used. With no $(U location) your IP address is used. US only.

$(B OPTIONS)
    $(B -h)           Show this help message

    $(B -u) $(U units)    $(I imperial) (°F, mph, inHg, mi, in) or $(I si) (°C, km/h, hPa, km, mm) $(I '(default: imperial)')

    [$(U location)]    One of the following $(I '(default: your IP location)')

                  $(I 10001)               zip code
                  $(I 40.71,-74.0)         latitude,longitude
                  $(I KNYC)                observation station id

$(B EXAMPLES)
    Conditions where you are

        wxnow

    Conditions at a station in SI units

        wxnow -u si KNYC

EOF
}

# observation STATION: print the latest observation json of STATION
observation() { curl -fsSL -A "$UA" "https://api.weather.gov/stations/$1/observations/latest"; }

# has_temp JSON: true when the observation reports a temperature
has_temp() { awk '/^        "temperature": *\{/ { f = 1 } f && /"value"/ { ok = $0 !~ /null/; f = 0 } END { exit !ok }' <<<"$1"; }

# render JSON UNITS AGE: print the observation as labelled lines
render() {
    awk -v si="$([[ $2 == si ]] && echo 1 || echo 0)" -v age="$3" -f "$AWKDIR/wx-emoji.awk" -f "$AWKDIR/wxnow.awk" <<<"$1"
}

main() {
    local units=imperial loc ll pt stations id obs='' name ts age=''
    while (($#)); do
        case $1 in
            -h) usage; exit 0 ;;
            -u) units=$(argval "$@" | tr "[:upper:]" "[:lower:]"); shift ;;
            --) shift; break ;;
            -*) warn "Unknown option: $1" ;;
            *) break ;;
        esac
        shift
    done
    (($# <= 1)) || warn "Unexpected argument: $2"
    loc=${1-}
    [[ $units == @(imperial|si) ]] || warn "Units must be imperial or si"
    command -v curl &>/dev/null || warn "curl not found"

    local -a ids
    if [[ $loc =~ ^[A-Za-z][A-Za-z0-9]{3}$ ]]; then
        ids=("$(tr '[:lower:]' '[:upper:]' <<<"$loc")")
    else
        ll=$(latlon "$loc") || warn "Location must be a zip code, latitude,longitude or a station id"
        # shellcheck disable=SC2086
        set -- $ll
        pt=$(curl -fsSL -A "$UA" "https://api.weather.gov/points/$1,$2") || warn "No NWS station for $1,$2 (US only)"
        stations=$(sed -n 's/.*"observationStations": *"\(.*\)".*/\1/p' <<<"$pt")
        mapfile -t ids < <(curl -fsSL -A "$UA" "$stations" | sed -n 's/.*"stationIdentifier": *"\([^"]*\)".*/\1/p' | head -5)
    fi
    ((${#ids[@]})) || warn "No observation stations found"

    for id in "${ids[@]}"; do
        obs=$(observation "$id") || continue
        has_temp "$obs" && break
        obs=''
    done
    [[ -n $obs ]] || warn "No recent observation from the nearest stations"

    name=$(sed -n 's/.*"stationName": *"\([^"]*\)".*/\1/p' <<<"$obs" | head -1)
    ts=$(sed -n 's/.*"timestamp": *"\([^"]*\)".*/\1/p' <<<"$obs" | head -1)
    if [[ -n $ts ]]; then
        local epoch mins
        epoch=$(iso_epoch "$ts")
        mins=$((($(date +%s) - epoch) / 60))
        age="$(stamp_fmt "$epoch"), $mins min ago"
        ((mins >= 120)) && age="$(stamp_fmt "$epoch"), $((mins / 60)) h ago"
    fi
    info "${name:-$id} ($id)"
    render "$obs" "$units" "$age"
}

main "$@"
